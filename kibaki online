async function initMultiplayerClient() {
  multiplayerApiBase = await findBestMultiplayerServer();
  if (location.protocol === "file:" && !multiplayerApiBase) {
    updateMultiplayerStatus("Solo hors serveur");
    return;
  }

  if (typeof window.io !== "function") {
    const socketLoaded = await loadSocketIoClient();
    if (!socketLoaded) {
      initHttpMultiplayerClient();
      return;
    }
  }

  multiplayerTransport = "socket";
  multiplayerSocket = window.io(multiplayerApiBase || undefined, {
    transports: ["websocket", "polling"],
    reconnection: true,
    reconnectionAttempts: Infinity,
    reconnectionDelay: 600,
    reconnectionDelayMax: 2500,
  });

  multiplayerSocket.on("connect", () => {
    multiplayer.connected = true;
    updateMultiplayerStatus("Serveur local connecte");
    if (multiplayer.roomCode) {
      multiplayerSocket.emit("joinRoom", {
        clientId: multiplayerClientId,
        roomCode: multiplayer.roomCode,
        playerName: getMultiplayerPlayerName(),
      });
      multiplayerSocket.emit("requestSync");
    } else if (shouldAutoJoinRoomFromUrl()) {
      window.setTimeout(joinMultiplayerRoom, 250);
    }
  });

  multiplayerSocket.on("disconnect", () => {
    multiplayer.connected = false;
    multiplayer.status = "offline";
    updateMultiplayerStatus("Serveur deconnecte");
  });

  multiplayerSocket.on("connect_error", () => {
    rotateMultiplayerServerCandidate();
  });

  multiplayerSocket.on("roomCreated", updateMultiplayerRoom);
  multiplayerSocket.on("roomJoined", updateMultiplayerRoom);
  multiplayerSocket.on("playerJoined", updateMultiplayerRoom);
  multiplayerSocket.on("gameStateUpdated", updateMultiplayerRoom);
  multiplayerSocket.on("playerDisconnected", (room) => {
    updateMultiplayerRoom(room);
    showMultiplayerDisconnectNotice(room);
  });
  multiplayerSocket.on("gameStarted", updateMultiplayerRoom);
  multiplayerSocket.on("actionRejected", (payload = {}) => {
    updateMultiplayerStatus(payload.message || "Action refusée");
  });
  multiplayerSocket.on("serverError", (payload = {}) => {
    updateMultiplayerStatus(payload.message || "Erreur serveur");
  });
}

async function findBestMultiplayerServer() {
  applyServerBaseFromUrl();
  for (const candidate of MULTIPLAYER_SERVER_CANDIDATES) {
    if (!candidate && location.protocol !== "file:") {
      return "";
    }
    if (await pingMultiplayerServer(candidate)) {
      return candidate;
    }
  }
  return MULTIPLAYER_SERVER_CANDIDATES[0] || "";
}

async function pingMultiplayerServer(baseUrl) {
  if (!baseUrl && location.protocol !== "file:") {
    return true;
  }
  if (!baseUrl) {
    return false;
  }
  try {
    const response = await fetchWithTimeout(`${baseUrl}/api/multiplayer/health`, {}, 1500);
    if (!response.ok) {
      return false;
    }
    const health = await response.json().catch(() => ({}));
    multiplayerPublicBase = health.publicBaseUrl || baseUrl || "";
    rememberMultiplayerServer(multiplayerPublicBase);
    return true;
  } catch {
    return false;
  }
}

function buildMultiplayerServerCandidates() {
  if (location.protocol !== "file:") {
    return [""];
  }
  return uniqueServerCandidates([
    getServerBaseFromUrl(),
    getStoredMultiplayerServer(),
    "http://192.168.2.77:4174",
    "http://127.0.0.1:4174",
  ]);
}

function uniqueServerCandidates(candidates) {
  const seen = new Set();
  return candidates
    .map(normalizeMultiplayerBaseUrl)
    .filter(Boolean)
    .filter((candidate) => {
      const key = candidate.toLowerCase();
      if (seen.has(key)) {
        return false;
      }
      seen.add(key);
      return true;
    });
}

function normalizeMultiplayerBaseUrl(value) {
  const rawValue = String(value || "").trim();
  if (!rawValue) {
    return "";
  }
  try {
    const url = new URL(/^https?:\/\//i.test(rawValue) ? rawValue : `http://${rawValue}`);
    if (!/^https?:$/i.test(url.protocol)) {
      return "";
    }
    return `${url.protocol}//${url.host}`.replace(/\/+$/, "");
  } catch {
    return "";
  }
}

function getStoredMultiplayerServer() {
  try {
    return localStorage.getItem(MULTIPLAYER_SERVER_STORAGE_KEY) || "";
  } catch {
    return "";
  }
}

function getServerBaseFromUrl() {
  try {
    return new URLSearchParams(location.search).get("server") || "";
  } catch {
    return "";
  }
}

function applyServerBaseFromUrl() {
  const serverBase = getServerBaseFromUrl();
  if (serverBase) {
    rememberMultiplayerServer(serverBase);
  }
}

function rememberMultiplayerServer(baseUrl) {
  const normalized = normalizeMultiplayerBaseUrl(baseUrl);
  if (!normalized || /\/\/(?:127\.|localhost(?::|$))/i.test(normalized)) {
    return "";
  }
  multiplayerPublicBase = normalized;
  multiplayerApiBase = normalized;
  const existingIndex = MULTIPLAYER_SERVER_CANDIDATES.findIndex((candidate) => candidate.toLowerCase() === normalized.toLowerCase());
  if (existingIndex >= 0) {
    MULTIPLAYER_SERVER_CANDIDATES.splice(existingIndex, 1);
  }
  MULTIPLAYER_SERVER_CANDIDATES.unshift(normalized);
  try {
    localStorage.setItem(MULTIPLAYER_SERVER_STORAGE_KEY, normalized);
  } catch {
    // Server memory is a comfort feature only; the QR still carries the current address.
  }
  return normalized;
}

async function rotateMultiplayerServerCandidate() {
  const currentIndex = MULTIPLAYER_SERVER_CANDIDATES.indexOf(multiplayerApiBase);
  const ordered = [
    ...MULTIPLAYER_SERVER_CANDIDATES.slice(currentIndex + 1),
    ...MULTIPLAYER_SERVER_CANDIDATES.slice(0, Math.max(0, currentIndex + 1)),
  ].filter(Boolean);
  for (const candidate of ordered) {
    if (candidate === multiplayerApiBase) {
      continue;
    }
    if (await pingMultiplayerServer(candidate)) {
      multiplayerApiBase = candidate;
      updateMultiplayerStatus(`Serveur trouve: ${serverConnectionLabel()}`);
      if (multiplayerSocket) {
        multiplayerSocket.removeAllListeners();
        multiplayerSocket.disconnect();
        multiplayerSocket = null;
      }
      initMultiplayerClient();
      return;
    }
  }
}

function loadSocketIoClient() {
  if (!multiplayerApiBase || typeof window.io === "function") {
    return Promise.resolve(typeof window.io === "function");
  }

  return new Promise((resolve) => {
    const script = document.createElement("script");
    const timeoutId = window.setTimeout(() => {
      script.remove();
      resolve(false);
    }, 5000);

    script.onload = () => {
      window.clearTimeout(timeoutId);
      resolve(typeof window.io === "function");
    };
    script.onerror = () => {
      window.clearTimeout(timeoutId);
      script.remove();
      resolve(false);
    };
    script.src = `${multiplayerApiBase}/socket.io/socket.io.js`;
    document.head.appendChild(script);
  });
}

