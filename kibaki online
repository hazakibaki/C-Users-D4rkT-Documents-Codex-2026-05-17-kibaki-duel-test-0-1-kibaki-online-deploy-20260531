  padding: 0;
  transition:
    transform 140ms ease,
    box-shadow 140ms ease,
    border-color 140ms ease;
}

.action-card-button {
  display: grid;
  align-content: end;
  justify-items: center;
  gap: 3px;
  isolation: isolate;
  padding: 0 8px 9px;
  color: #ffffff;
  font-weight: 950;
  line-height: 1;
  text-align: center;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95);
  text-transform: uppercase;
}

.action-card-button::before {
  content: "";
  position: absolute;
  inset: 58% 0 0;
  z-index: 0;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0));
  pointer-events: none;
}

.action-card-button span,
.action-card-button small {
  position: relative;
  z-index: 1;
}

.action-card-button span {
  max-width: 100%;
  font-size: 0.58rem;
}

.action-card-button small {
  color: rgba(255, 255, 255, 0.86);
  font-size: 0.42rem;
  font-weight: 900;
}

.center-card-cover:hover {
  border-color: var(--gold);
  transform: translateY(-4px) scale(1.04);
  box-shadow:
    0 0 0 14px rgba(255, 208, 90, 0.1),
    0 0 36px rgba(255, 208, 90, 0.66),
    0 18px 28px rgba(0, 0, 0, 0.48);
}

.center-card-cover.action-card-button:hover {
  transform: translateY(-4px) scale(1.04);
}

.action-card-button:disabled {
  cursor: not-allowed;
  filter: grayscale(0.45);
  opacity: 0.66;
}

.draw-reveal {
  position: absolute;
  z-index: 4;
  top: 0;
  left: 50%;
  opacity: 0;
  overflow: visible;
  pointer-events: none;
  perspective: 720px;
  transform: translateX(-50%) translateY(-8%) scale(0.86);
}

.instant-reveal {
  position: absolute;
  z-index: 6;
  top: 50%;
  left: 50%;
  opacity: 0;
  overflow: visible;
  pointer-events: none;
  transform: translate(-50%, -50%) scale(0.74);
}

.draw-reveal.show {
  animation: draw-pop 1600ms ease both;
}

.instant-reveal.show {
  animation: instant-pop 1400ms ease both;
}

.flip-card {
  position: relative;
  width: 100%;
  aspect-ratio: 5 / 7;
  transform-style: preserve-3d;
}

.draw-reveal.show .flip-card {
  animation: card-flip 960ms cubic-bezier(0.2, 0.8, 0.22, 1) forwards;
}

.flip-face {
  position: absolute;
  inset: 0;
  overflow: hidden;
  border: 2px solid rgba(255, 255, 255, 0.8);
  border-radius: 7px;
  backface-visibility: hidden;
  background: #061426;
  box-shadow: 0 0 28px rgba(21, 150, 255, 0.8);
}

.flip-front {
  transform: rotateY(180deg);
}

.draw-reveal span {
  display: block;
  margin-top: 5px;
  color: #ffffff;
  font-size: 0.72rem;
  font-weight: 900;
  text-transform: uppercase;
  text-shadow: 0 0 12px rgba(21, 150, 255, 0.85);
}

.instant-reveal span {
  display: block;
  width: max-content;
  max-width: 260px;
  margin-top: 7px;
  padding: 5px 9px;
  border: 1px solid rgba(255, 208, 90, 0.66);
  border-radius: 6px;
  background: rgba(2, 8, 18, 0.88);
  color: #ffffff;
  font-size: 0.66rem;
  font-weight: 950;
  text-align: center;
  text-transform: uppercase;
  text-shadow: 0 0 12px rgba(255, 208, 90, 0.78);
}

.deck-visual img,
.played-card img,
.hand-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

@keyframes instant-pop {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.56);
  }

  14%,
  78% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(0.92);
  }

  100% {
    opacity: 0;
    transform: translate(-50%, -54%) scale(0.84);
  }
}

@keyframes card-flip {
  0% {
    transform: rotateY(0deg);
  }

  58%,
  100% {
    transform: rotateY(180deg);
  }
}

@keyframes draw-pop {
  0% {
    opacity: 0;
    transform: translateX(-50%) translateY(16%) scale(0.56);
  }

  18% {
    opacity: 1;
  }

  64% {
    opacity: 1;
    transform: translateX(-50%) translateY(-13%) scale(1.08);
  }

  100% {
    opacity: 0;
    transform: translateX(-50%) translateY(-18%) scale(0.96);
  }
}

