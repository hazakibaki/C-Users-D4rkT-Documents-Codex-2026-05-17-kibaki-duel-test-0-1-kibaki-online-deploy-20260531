function buildDeck() {
  const fullDeck = cardDefinitions.flatMap(([name, type, color, file], index) => {
    const copies = type === "normal" ? 2 : 1;
    return Array.from({ length: copies }, (_, copyIndex) => ({
      id: `${index}-${copyIndex}-${file}`,
      name,
      type,
      color,
      image: `./assets/cards/${encodeURIComponent(file)}`,
      destroyed: false,
      captured: false,
    }));
  });
  const profile = getDifficultyProfile();
  if (profile.quickDeck) {
    const seenCards = new Set();
    return fullDeck.filter((card) => {
      const key = card.type === "normal" ? `normal-${card.name}` : card.type;
      if (seenCards.has(key)) {
        return false;
      }
      seenCards.add(key);
      return true;
    });
  }

  const wantedCount = Math.max(game.playerCount * 5, Math.ceil(fullDeck.length * profile.deckFraction));
  return shuffle(fullDeck).slice(0, Math.min(fullDeck.length, wantedCount));
}

