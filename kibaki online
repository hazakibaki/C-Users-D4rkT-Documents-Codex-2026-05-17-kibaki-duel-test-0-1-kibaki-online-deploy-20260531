app = "kibaki-online"
primary_region = "yyz"

[env]
  HOST = "0.0.0.0"
  PORT = "8080"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

[[vm]]
  memory = "512mb"
  cpu_kind = "shared"
  cpus = 1

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KIBAKI !</title>
    <link rel="icon" type="image/png" href="./assets/app/app-logo.png" />
    <link rel="stylesheet" href="./styles.css?v=7" />
  </head>
  <body class="is-audio-gate is-studio is-loading menu-open">
    <div id="transitionCover" class="transition-cover" aria-hidden="true">
      <img src="./assets/app/menu-logo-transparent.png" alt="" />
      <span>Rotation</span>
    </div>

    <section id="audioGate" class="audio-gate" aria-label="Demarrer KIBAKI">
      <button id="audioGateButton" class="audio-gate-button" type="button">
        <img src="./assets/app/menu-logo-transparent.png" alt="KIBAKI" />
        <span>Demarrer</span>
      </button>
      <div class="audio-gate-loader" aria-live="polite">
        <span id="audioGateLoadLabel">Préchargement HAZA</span>
        <div class="audio-gate-bar" aria-hidden="true"><i></i></div>
      </div>
    </section>

    <section id="studioScreen" class="studio-screen" aria-label="HAZA Studio">
      <img src="./assets/app/haza-studio-pc.png" data-pc-src="./assets/app/haza-studio-pc.png" data-apk-src="./assets/app/haza-studio.png" alt="HAZA Studio" />
    </section>

    <section id="loadingScreen" class="loading-screen" aria-label="Chargement de KIBAKI">
      <div class="loading-panel">
        <img src="./assets/app/menu-logo-transparent.png" alt="KIBAKI" />
        <p>Chargement</p>
        <div class="loading-bar" aria-hidden="true">
          <span id="loadingProgress" class="wave"></span>
        </div>
        <strong id="loadingLabel">PRÉPARATION DES CARTES...</strong>
        <small id="loadingFlavor" class="loading-flavor">Le paquet se mélange en coulisse.</small>
      </div>
    </section>

    <section id="mainMenu" class="main-menu" aria-label="Menu principal">
      <div class="main-menu-panel">
        <img class="main-menu-logo" src="./assets/app/menu-logo-transparent.png" alt="Logo KIBAKI" />
        <div class="menu-actions">
          <button id="menuNewGameButton" class="menu-primary-button" type="button">Nouvelle partie</button>
          <button id="menuContinueButton" class="menu-secondary-button hidden" type="button">Continuer</button>
          <button id="menuQuitButton" class="menu-secondary-button" type="button">Quitter</button>
        </div>
      </div>
    </section>

    <main class="game-shell">
      <header class="topbar">
        <button id="menuButton" class="logo-menu-button" type="button" aria-label="Ouvrir le menu">
          <img src="./assets/app/menu-logo-transparent.png" alt="KIBAKI" />
          <span>Menu</span>
        </button>
      </header>

      <section id="quickMenuPanel" class="quick-menu-panel hidden" aria-label="Menu rapide">
        <div class="quick-menu-actions">
          <button id="resetButton" class="quick-menu-button" type="button">Nouvelle partie</button>
          <button id="expansionButton" class="quick-menu-button" type="button">Expansion</button>
          <button id="muteButton" class="quick-menu-button mute-button" type="button">Sourdine</button>
          <button id="quitButton" class="quick-menu-button quit-button" type="button">Quitter</button>
        </div>
        <div class="quick-volume-controls" aria-label="Volumes">
          <label class="volume-control" for="musicVolumeSlider">
            <span>Musique</span>
            <input id="musicVolumeSlider" type="range" min="0" max="100" value="100" />
          </label>
          <label class="volume-control" for="effectsVolumeSlider">
            <span>Effets</span>
            <input id="effectsVolumeSlider" type="range" min="0" max="100" value="100" />
          </label>
        </div>
      </section>

      <button id="rulesButton" class="rules-card-button rules-reference-card" type="button" aria-label="Voir la carte règlement">
        <img src="./assets/cards/001%20REGLEMENT.png" alt="Carte règlement KIBAKI" />
      </button>
      <button id="goldRulesButton" class="rules-card-button golden-reference-card" type="button" aria-label="Voir la règle d'or">
        <img src="./assets/cards/001%20REGLEMENT%20D%27OR.png" alt="Carte règle d'or KIBAKI" />
      </button>

      <section class="setup-panel" id="setupPanel">
        <div>
          <p class="turn-label">Mise en place</p>
          <h2>Choisis le nombre de joueurs</h2>
        </div>
        <label class="name-field" for="playerNameInput">
          <span>Nom</span>
          <input id="playerNameInput" type="text" maxlength="18" autocomplete="nickname" placeholder="Joueur 1" />
        </label>
        <div class="player-count" role="group" aria-label="Nombre de joueurs">
          <button class="count-button selected" type="button" data-count="2">2</button>
          <button class="count-button" type="button" data-count="3">3</button>
          <button class="count-button" type="button" data-count="4">4</button>
        </div>
        <section class="mode-panel" aria-label="Mode de jeu">
          <span>Mode de jeu</span>
          <div class="difficulty-select" role="group" aria-label="Difficulté">
            <button class="difficulty-button" type="button" data-difficulty="quick">Éclair</button>
            <button class="difficulty-button selected" type="button" data-difficulty="facile">Facile</button>
            <button class="difficulty-button" type="button" data-difficulty="normal">Moyen</button>
            <button class="difficulty-button" type="button" data-difficulty="brutal">Brutal</button>
          </div>
        </section>
        <div class="setup-actions">
          <button id="startButton" class="primary-button" type="button">Mélanger et distribuer</button>
          <button id="openMultiplayerButton" class="menu-secondary-button multiplayer-open-button" type="button">Multijoueur</button>
          <button id="setupQuitButton" class="menu-secondary-button setup-quit-button" type="button">Quitter</button>
        </div>
      </section>

      <section class="status-strip" aria-label="Etat de la partie">
        <div>
          <span>Paquet</span>
          <strong id="deckCount">0</strong>
        </div>
        <div>
          <span>Defausse commune</span>
          <strong id="discardCount">0</strong>
        </div>
        <div>
          <span>Ronde</span>
          <strong id="roundCount">0</strong>
        </div>
        <div>
          <span>Temps</span>
          <strong id="gameTimer">00:00</strong>
        </div>
        <div>
          <span>Phase</span>
          <strong id="phaseLabel">Setup</strong>
          <div id="phaseDots" class="phase-dots" aria-hidden="true"></div>
        </div>
      </section>

      <div class="app-board">
        <aside class="left-column">
          <section class="won-zone" aria-label="Cartes gagnantes">
            <p class="turn-label">Cartes gagnantes</p>
            <span>(points)</span>
            <strong id="wonCount">0</strong>
            <small id="wonOwnerLabel">Joueur 1</small>
            <div id="wonStack" class="won-stack" aria-label="Dernieres cartes gagnantes"></div>
          </section>

          <section class="score-zone" aria-label="Scores">
            <h2>Scores</h2>
            <div id="scoreboard" class="scoreboard"></div>
          </section>
        </aside>

        <div class="arena-column">
          <section class="table-zone" aria-label="Table de duel">
            <div class="table-center">
              <button id="actionButton" class="center-card-cover action-card-button" type="button" aria-label="Action principale">
                <span id="actionButtonLabel">Lancer la partie</span>
                <small id="actionButtonHint">Espace</small>
              </button>
              <div id="drawReveal" class="deck-visual draw-reveal" aria-live="polite">
                <div class="flip-card">
                  <div class="flip-face flip-back">
                    <img src="./assets/cards/back.png" alt="Dos de carte KIBAKI" />
                  </div>
                  <div class="flip-face flip-front">
                    <img id="drawRevealImage" src="./assets/cards/back.png" alt="Carte pigee" />
                  </div>
                </div>
                <span id="drawRevealLabel">Carte pigee</span>
              </div>
              <div id="instantReveal" class="deck-visual instant-reveal" aria-live="polite">
                <img id="instantRevealImage" src="./assets/cards/back.png" alt="Instant joue" />
                <span id="instantRevealLabel">Instant</span>
              </div>
              <div class="center-copy">
                <p class="turn-label">Reveal</p>
                <h2 id="turnTitle">Prêt à jouer</h2>
                <p id="phaseHint" class="hint">Mélange le paquet central pour commencer.</p>
              </div>
            </div>
            <div id="battleSlots" class="battle-slots"></div>
          </section>

          <section class="hand-zone" aria-label="Main du joueur actif">
            <div class="hand-header">
              <div>
                <p class="turn-label">Main active</p>
                <h2 id="activePlayerTitle">Aucun joueur</h2>
              </div>
            </div>
            <div class="hand-row">
              <div id="handCards" class="hand-cards"></div>
              <button id="skipInstantButton" class="next-button hidden" type="button">Suivant</button>
            </div>
          </section>
        </div>

        <section class="log-zone" aria-label="Journal du duel">
          <div class="panel-heading">
            <h2>Journal</h2>
            <span>Live</span>
          </div>
          <ol id="battleLog"></ol>
        </section>
      </div>
    </main>

    <dialog id="rulesDialog" class="rules-dialog">
      <button id="closeRulesButton" class="dialog-close" type="button" aria-label="Fermer">x</button>
      <div class="rules-dialog-cards">
        <img src="./assets/cards/001%20REGLEMENT%20D%27OR.png" alt="Carte règle d'or KIBAKI" />
        <img src="./assets/cards/001%20REGLEMENT.png" alt="Carte règlement KIBAKI" />
      </div>
      <section class="golden-rule">
        <h2>Règle d'or ;)</h2>
        <p>Une carte battue ou détruite devient une carte gagnante: elle vaut 1 point et reste dans la pile du joueur qui l'a gagnée.</p>
        <p>Si le paquet et la défausse commune sont vides, la partie se termine et on compte les cartes gagnantes.</p>
      </section>
    </dialog>

    <dialog id="cardZoomDialog" class="card-zoom-dialog">
      <button id="closeCardZoomButton" class="dialog-close" type="button" aria-label="Fermer">x</button>
      <img id="cardZoomImage" src="./assets/cards/back.png" alt="Carte agrandie" />
      <strong id="cardZoomLabel">Paquet central</strong>
    </dialog>

    <dialog id="gameOverDialog" class="game-over-dialog">
      <div class="game-over-panel">
        <p class="turn-label">Fin de partie</p>
        <h2 id="gameOverTitle">Victoire</h2>
        <p id="gameOverSummary" class="game-over-summary">Le duel est terminé.</p>
        <div id="gameOverScores" class="game-over-scores"></div>
        <div class="game-over-actions">
          <button id="gameOverReplayButton" class="menu-primary-button" type="button">Rejouer</button>
          <button id="gameOverQuitButton" class="menu-secondary-button" type="button">Quitter</button>
        </div>
      </div>
    </dialog>

    <dialog id="hostDisconnectDialog" class="host-disconnect-dialog">
      <div class="game-over-panel">
        <p class="turn-label">Connexion perdue</p>
        <h2 id="hostDisconnectTitle">L'hôte a quitté</h2>
        <p id="hostDisconnectSummary" class="game-over-summary">La partie ne peut plus continuer.</p>
        <div class="game-over-actions">
          <button id="hostDisconnectQuitButton" class="menu-secondary-button" type="button">Quitter</button>
        </div>
      </div>
    </dialog>

    <dialog id="multiplayerDialog" class="multiplayer-dialog">
      <button id="closeMultiplayerDialogButton" class="dialog-close" type="button" aria-label="Fermer">x</button>
      <section class="multiplayer-panel" aria-label="Multijoueur local">
        <div class="multiplayer-header">
          <span>Lobby multijoueur</span>
          <small>2 à 4 joueurs local</small>
        </div>
        <div class="multiplayer-actions">
          <button id="createRoomButton" class="multiplayer-button multiplayer-button-primary" type="button">Héberger</button>
          <button id="joinRoomButton" class="multiplayer-button multiplayer-button-primary" type="button">Joindre</button>
          <button id="syncRoomButton" class="multiplayer-button sync-room-button" type="button">Connexion</button>
        </div>
        <label class="room-code-field" for="roomCodeInput">
          <span>Code de partie</span>
          <input id="roomCodeInput" type="text" maxlength="6" autocomplete="off" placeholder="KIB123" />
        </label>
        <div class="multiplayer-status">
          <strong id="roomStatusLabel">Solo hors serveur</strong>
          <span id="roomCodeLabel">Code: --</span>
        </div>
        <div class="room-players" aria-label="Sièges de la partie">
          <span id="roomPlayerOne" class="room-seat">Siège 1 · --</span>
          <span id="roomPlayerTwo" class="room-seat">Siège 2 · --</span>
          <span id="roomPlayerThree" class="room-seat">Siège 3 · --</span>
          <span id="roomPlayerFour" class="room-seat">Siège 4 · --</span>
        </div>
        <div class="room-debug-panel" aria-label="État multijoueur">
          <div>
            <span>Connexion</span>
            <strong id="roomTransportLabel">--</strong>
          </div>
          <div>
            <span>Spectateur</span>
            <strong id="roomViewerLabel">--</strong>
          </div>
          <div>
            <span>Phase</span>
            <strong id="roomPhaseLabel">Lobby</strong>
          </div>
          <div>
            <span>Action</span>
            <strong id="roomActionLabel">Héberger ou joindre</strong>
          </div>
        </div>
        <div id="roomQrPanel" class="room-qr-panel" hidden>
          <img id="roomQrImage" alt="QR code de partie" />
          <span>Scanner pour rejoindre</span>
          <small id="roomJoinLink">--</small>
        </div>
        <div id="roomScannerPanel" class="room-scanner-panel" hidden>
          <video id="roomScannerVideo" muted playsinline></video>
          <div class="room-scanner-actions">
            <strong id="roomScannerStatus">Caméra prête</strong>
            <button id="closeRoomScannerButton" class="multiplayer-button" type="button">Fermer</button>
          </div>
        </div>
        <button id="roomStartButton" class="primary-button room-start-button" type="button" disabled>Mélanger et distribuer</button>
      </section>
    </dialog>

    <script src="./assets/vendor/socket.io.min.js"></script>
    <script src="./main.js"></script>
  </body>
</html>

