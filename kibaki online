}

.center-card-cover,
.deck-visual {
  width: 68%;
  min-width: 92px;
  aspect-ratio: 5 / 7;
  overflow: hidden;
  border: 2px solid rgba(235, 247, 255, 0.78);
  border-radius: 7px;
  background: #061426;
  box-shadow:
    0 0 0 13px rgba(21, 150, 255, 0.08),
    0 0 30px rgba(21, 150, 255, 0.75),
    0 16px 26px rgba(0, 0, 0, 0.45);
}

.center-card-cover {
  position: relative;
  background:
    url("./assets/cards/back.png") center / cover no-repeat,
    radial-gradient(circle at center, rgba(35, 144, 255, 0.3), rgba(2, 9, 22, 0.96) 58%),
    linear-gradient(145deg, rgba(1, 8, 18, 0.98), rgba(4, 22, 48, 0.95));
