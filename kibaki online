function runLoadingTimer(preloadPromise) {
  const duration = getRandomLoadingDuration();
  const startedAt = performance.now();
  updateLoadingProgress(0, duration);
  updateLoadingFlavor(startedAt, true);

  return new Promise((resolve) => {
    const interval = window.setInterval(() => {
      const now = performance.now();
      const elapsed = now - startedAt;
      const timedProgress = Math.min(elapsed / duration, 1);
      const assetProgress = getLoadingAssetProgress();
      const progress = Math.min(timedProgress * 0.62 + assetProgress * 0.36, 0.98);
      updateLoadingProgress(progress, Math.max(0, duration - elapsed));
      updateLoadingFlavor(now);
    }, 120);

    Promise.allSettled([delay(duration), preloadPromise]).then(() => {
      window.clearInterval(interval);
      updateLoadingProgress(1, 0);
      if (elements.loadingFlavor) {
        elements.loadingFlavor.textContent = "Duel prêt. À toi de jouer.";
      }
      resolve();
    });
  });
}

function getRandomLoadingDuration() {
  return Math.round(LOADING_MIN_MS + Math.random() * (LOADING_MAX_MS - LOADING_MIN_MS));
}

function updateLoadingProgress(progress, remainingMs) {
  const percent = Math.round(Math.min(Math.max(progress, 0), 1) * 100);
  const message = getLoadingMessage(progress);
  const assetText = getLoadingAssetText();
  if (elements.loadingProgress) {
    elements.loadingProgress.style.width = `${percent}%`;
    elements.loadingProgress.style.height = "100%";
  }
  if (elements.loadingLabel) {
    elements.loadingLabel.textContent = percent >= 100 ? "PRÊT À JOUER" : `${message}...`;
  }
}

function getLoadingAssetProgress() {
  if (!loadingAssetProgress.total) {
    return 0;
  }
  return Math.min(loadingAssetProgress.loaded / loadingAssetProgress.total, 1);
}

function getLoadingAssetText() {
  if (!loadingAssetProgress.total) {
    return "";
  }
  return `${loadingAssetProgress.loaded}/${loadingAssetProgress.total}`;
}

function getLoadingMessage(progress) {
  const safeProgress = Math.min(Math.max(progress, 0), 0.999);
  const index = Math.floor(safeProgress * LOADING_MESSAGES.length);
  return LOADING_MESSAGES[index] || LOADING_MESSAGES[0];
}

function updateLoadingFlavor(now = performance.now(), force = false) {
  if (!elements.loadingFlavor || (!force && now < nextLoadingFlavorAt)) {
    return;
  }

  let nextIndex = loadingFlavorIndex;
  if (LOADING_FLAVOR_TEXTS.length > 1) {
    while (nextIndex === loadingFlavorIndex) {
      nextIndex = Math.floor(Math.random() * LOADING_FLAVOR_TEXTS.length);
    }
  } else {
    nextIndex = 0;
  }

  loadingFlavorIndex = nextIndex;
  elements.loadingFlavor.textContent = LOADING_FLAVOR_TEXTS[loadingFlavorIndex];
  nextLoadingFlavorAt = now + 3500 + Math.random() * 3500;
}

function formatLoadingTime(milliseconds) {
  const seconds = Math.max(0, Math.ceil(milliseconds / 1000));
  const minutes = Math.floor(seconds / 60);
  const rest = seconds % 60;
  return minutes > 0 ? `${minutes}m ${String(rest).padStart(2, "0")}s` : `${seconds}s`;
}

function getPreloadAssets() {
  return [
    ...new Set([
      ...PRELOAD_IMAGE_ASSETS,
      getStudioImageSrc(),
      ...cardDefinitions.map(([, , , file]) => `./assets/cards/${encodeURIComponent(file)}`),
      ...Object.values(SOUND_FILES),
    ]),
  ];
