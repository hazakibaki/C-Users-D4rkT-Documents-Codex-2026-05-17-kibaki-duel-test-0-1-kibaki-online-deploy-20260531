function playSound(name, options = {}) {
  initAudio();
  const audio = audioTracks.get(name);
  if (!audio) {
    return Promise.resolve(false);
  }

  audio.loop = Boolean(options.loop);
  audio.dataset.baseVolume = String(options.volume ?? 0.82);
  audio.volume = getAdjustedVolume(name, Number(audio.dataset.baseVolume));
  if (options.restart) {
    audio.currentTime = 0;
  } else if (audio.loop && !audio.paused && !audio.ended) {
    return Promise.resolve(true);
  }

  return audio.play().then(() => true).catch(() => false);
}

function playLoopingMusic(name, options = {}) {
  MUSIC_SOUND_NAMES.forEach((soundName) => {
    if (soundName !== name) {
      stopSound(soundName);
    }
  });
  return playSound(name, { ...options, loop: true });
}

function playIntroSound() {
  const primary = audioTracks.get("intro");
  const introEnded = waitForAudioEnd(primary, INTRO_MAX_WAIT_MS);
