function extractRoomCode(value) {
  const text = String(value || "").trim();

  try {
    const url = new URL(text);
    const embeddedServer = normalizeMultiplayerBaseUrl(url.searchParams.get("server")) || normalizeMultiplayerBaseUrl(url.origin);
    if (embeddedServer) {
      rememberMultiplayerServer(embeddedServer);
    }
    const roomParam = normalizeRoomCode(url.searchParams.get("room"));
    if (roomParam) {
      return roomParam;
    }
    const pathMatch = url.pathname.match(/\/(KIB[A-Z0-9]{3})\b/i);
    const pathRoomCode = normalizeRoomCode(pathMatch?.[1]);
    if (pathRoomCode) {
      return pathRoomCode;
    }
  } catch {
    // Plain room codes fall through below.
  }

  const directRoomCode = normalizeRoomCode(text);
  if (directRoomCode) {
    return directRoomCode;
  }

  const directMatch = text.match(/\bKIB[A-Z0-9]{3}\b/i);
  return normalizeRoomCode(directMatch?.[0]);
}

