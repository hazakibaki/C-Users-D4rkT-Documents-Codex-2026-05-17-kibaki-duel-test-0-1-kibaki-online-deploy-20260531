  if ("BarcodeDetector" in window && navigator.mediaDevices?.getUserMedia) {
    await openRoomScanner();
    return;
  }
  updateMultiplayerStatus("Caméra QR non disponible: entre le code de partie");
  elements.roomCodeInput?.focus();
}

function shouldUseHttpMultiplayer() {
  return multiplayerTransport !== "socket" || !multiplayerSocket;
}

async function createHttpMultiplayerRoom() {
  multiplayerTransport = "http";
  multiplayer.connected = true;
  const preferredRoomCode = createLocalRoomCode();
  updateMultiplayerRoom({
    code: preferredRoomCode,
    status: "waiting",
    hostSeat: 1,
    viewerSeat: 1,
    players: [{ name: getMultiplayerPlayerName() || "Joueur 1", seat: 1, connected: true }],
  });
  updateMultiplayerStatus("En attente du Joueur 2");
  startHttpMultiplayerPolling();
  try {
    const result = await getMultiplayerJsonp(
      `${multiplayerApiBase}/api/rooms/create?clientId=${encodeURIComponent(multiplayerClientId)}&playerName=${encodeURIComponent(getMultiplayerPlayerName())}&roomCode=${encodeURIComponent(preferredRoomCode)}`
    );
    updateMultiplayerRoom(result.room);
  } catch (error) {
    updateMultiplayerStatus(error.message || "Impossible de creer la partie");
  }
}

function createLocalRoomCode() {
  const alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
  let code = "KIB";
  for (let index = 0; index < 3; index += 1) {
    code += alphabet[Math.floor(Math.random() * alphabet.length)];
  }
  return code;
}

async function joinHttpMultiplayerRoom() {
  multiplayerTransport = "http";
  multiplayer.connected = true;
  const roomCode = getRoomCodeInputValue();
  if (!roomCode) {
    handleInvalidRoomCodeInput();
    return;
  }

  try {
    const result = await getMultiplayerJsonp(
      `${multiplayerApiBase}/api/rooms/join?clientId=${encodeURIComponent(multiplayerClientId)}&roomCode=${encodeURIComponent(roomCode)}&playerName=${encodeURIComponent(getMultiplayerPlayerName())}`
    );
    updateMultiplayerRoom(result.room);
    startHttpMultiplayerPolling();
  } catch (error) {
    updateMultiplayerStatus(error.message || "Impossible de rejoindre la partie");
  }
}

async function syncRoomByCode() {
  const roomCode = normalizeRoomCode(elements.roomCodeInput?.value || multiplayer.roomCode);
  if (!roomCode) {
    handleInvalidRoomCodeInput();
    return false;
  }

  multiplayer.roomCode = roomCode;
  multiplayer.connected = true;
  if (elements.roomCodeInput) {
    elements.roomCodeInput.value = roomCode;
  }
  updateMultiplayerStatus("Synchronisation...");
  reconnectMultiplayerSocket();
  if (multiplayerTransport === "socket" && multiplayerSocket?.connected) {
    multiplayerSocket.emit("joinRoom", {
      clientId: multiplayerClientId,
      roomCode,
      playerName: getMultiplayerPlayerName(),
    });
    multiplayerSocket.emit("requestSync");
    return true;
  }

  multiplayerTransport = "http";
  try {
    await joinOrCreateHttpRoom(roomCode);
    startHttpMultiplayerPolling();
    return true;
  } catch (error) {
    updateMultiplayerStatus(error.message || "Code prêt à rejoindre");
    return false;
  }
}

async function handleMultiplayerConnectionButton() {
  if (multiplayer.game && multiplayer.status === "playing") {
    updateMultiplayerStatus("Partie multi deja lancee");
    return;
  }

  const synced = await syncRoomByCode();
  if (!synced) {
    return;
  }

  const connectedPlayers = multiplayer.players.filter((player) => player.connected !== false);
  if (multiplayer.viewerSeat === 1 && connectedPlayers.length >= 2) {
    await startMultiplayerBetaGame();
    return;
  }

  if (multiplayer.viewerSeat === 1) {
    updateMultiplayerStatus("Siege 1 pret: attente de joueurs");
    return;
  }

  updateMultiplayerStatus(multiplayer.viewerSeat === 2 ? "Siege 2 connecte: attente de l'hote" : "Connexion synchronisee");
}

async function startMultiplayerFromLobby() {
  if (!multiplayer.roomCode && elements.roomCodeInput?.value) {
    multiplayer.roomCode = normalizeRoomCode(elements.roomCodeInput.value);
  }
  if (multiplayer.roomCode) {
    await syncRoomByCode();
  }
  const connectedPlayers = multiplayer.players.filter((player) => player.connected !== false);
  if (multiplayer.viewerSeat !== 1) {
    updateMultiplayerStatus("Seul le Siege 1 peut lancer la partie");
    return;
  }
  if (connectedPlayers.length < 2) {
    updateMultiplayerStatus("Attente d'au moins 2 joueurs");
    return;
  }
  await startMultiplayerBetaGame();
}

function openMultiplayerDialog() {
  closeQuickMenu();
  elements.multiplayerDialog?.showModal();
  renderMultiplayerPanel();
}

function closeMultiplayerDialog() {
  closeRoomScanner();
  elements.multiplayerDialog?.close();
}

function reconnectMultiplayerSocket() {
  if (multiplayerTransport !== "socket" || !multiplayerSocket) {
    return;
  }
  if (!multiplayerSocket.connected) {
    multiplayerSocket.connect();
  }
}

async function joinOrCreateHttpRoom(roomCode) {
  try {
    const joined = await getMultiplayerJsonp(
      `${multiplayerApiBase}/api/rooms/join?clientId=${encodeURIComponent(multiplayerClientId)}&roomCode=${encodeURIComponent(roomCode)}&playerName=${encodeURIComponent(getMultiplayerPlayerName())}`
    );
    updateMultiplayerRoom(joined.room);
    return joined;
  } catch (error) {
    if (!/introuvable/i.test(error.message || "")) {
      throw error;
    }
  }

  const created = await getMultiplayerJsonp(
    `${multiplayerApiBase}/api/rooms/create?clientId=${encodeURIComponent(multiplayerClientId)}&playerName=${encodeURIComponent(getMultiplayerPlayerName())}&roomCode=${encodeURIComponent(roomCode)}`
  );
  updateMultiplayerRoom(created.room);
  return created;
}

function shouldStartMultiplayerBeta() {
  return game.phase === "setup"
    && multiplayer.roomCode
    && multiplayer.players.length >= 2
    && multiplayer.viewerSeat === 1
    && (multiplayerTransport === "http" || multiplayerTransport === "socket");
}

async function startMultiplayerBetaGame() {
  closeQuickMenu();
  closeMultiplayerDialog();
  showTransitionCover();
  updateMultiplayerStatus("Lancement multi...");
  if (multiplayerTransport === "socket" && multiplayerSocket?.connected) {
    multiplayerSocket.emit("startGame");
    window.setTimeout(() => {
      document.body.classList.remove("menu-open");
      setAppOrientation("landscape");
      requestAppFullscreen();
      hideTransitionCover();
      fitBoardToViewport();
    }, 400);
    return;
  }

  try {
    await sendMultiplayerAction("start");
    window.setTimeout(() => {
      document.body.classList.remove("menu-open");
      setAppOrientation("landscape");
      requestAppFullscreen();
      hideTransitionCover();
      fitBoardToViewport();
    }, 400);
  } catch (error) {
    hideTransitionCover();
    updateMultiplayerStatus(error.message || "Impossible de lancer le multi");
  }
}

async function sendMultiplayerAction(action, cardId = "") {
  if (multiplayerTransport === "socket" && multiplayerSocket?.connected) {
    multiplayerSocket.emit("playerAction", { action, cardId });
    return { ok: true };
  }

  multiplayerTransport = "http";
  multiplayer.connected = true;
  const result = await getMultiplayerJsonp(
    `${multiplayerApiBase}/api/rooms/action?clientId=${encodeURIComponent(multiplayerClientId)}&roomCode=${encodeURIComponent(multiplayer.roomCode)}&action=${encodeURIComponent(action)}&cardId=${encodeURIComponent(cardId)}`
  );
  updateMultiplayerRoom(result.room);
  return result;
}

async function postMultiplayerJson(url, payload) {
  const response = await fetchWithTimeout(url, {
    method: "POST",
    headers: { "Content-Type": "text/plain;charset=UTF-8" },
    body: JSON.stringify(payload),
  });
  return readMultiplayerJson(response);
}

async function getMultiplayerJson(url) {
  const response = await fetchWithTimeout(url);
  return readMultiplayerJson(response);
}

function getMultiplayerJsonp(url) {
  return new Promise((resolve, reject) => {
    const callbackName = `kibakiJsonp${Date.now()}${Math.random().toString(36).slice(2)}`;
    const separator = url.includes("?") ? "&" : "?";
    const script = document.createElement("script");
    const timeoutId = window.setTimeout(() => {
      cleanup();
      reject(new Error("Serveur local trop lent"));
    }, 30000);

    function cleanup() {
      window.clearTimeout(timeoutId);
      delete window[callbackName];
      script.remove();
    }

    window[callbackName] = (payload) => {
      cleanup();
      if (payload?.message && !payload?.room) {
        reject(new Error(payload.message));
        return;
      }
      resolve(payload);
    };
    script.onerror = () => {
      cleanup();
      reject(new Error("Serveur local introuvable"));
    };
    script.src = `${url}${separator}callback=${callbackName}`;
    document.head.appendChild(script);
  });
}

async function fetchWithTimeout(url, options = {}, timeoutMs = 6000) {
  const controller = new AbortController();
  const timeoutId = window.setTimeout(() => controller.abort(), timeoutMs);
  try {
    return await fetch(url, {
      ...options,
      signal: controller.signal,
    });
  } finally {
    window.clearTimeout(timeoutId);
  }
}

async function readMultiplayerJson(response) {
  const result = await response.json().catch(() => ({}));
  if (!response.ok) {
    throw new Error(result.message || "Erreur reseau locale");
  }
  return result;
}

function startHttpMultiplayerPolling() {
  window.clearInterval(multiplayerPollTimer);
  multiplayerPollTimer = window.setInterval(syncHttpMultiplayerRoom, 1200);
}

async function syncHttpMultiplayerRoom() {
  if (multiplayerTransport !== "http" || !multiplayer.roomCode) {
    return;
  }

  try {
    const result = await getMultiplayerJsonp(`${multiplayerApiBase}/api/rooms/${encodeURIComponent(multiplayer.roomCode)}?clientId=${encodeURIComponent(multiplayerClientId)}`);
    updateMultiplayerRoom(result.room);
  } catch (error) {
    if (!multiplayer.players.length) {
      updateMultiplayerStatus(error.message || "Synchronisation perdue");
    }
  }
}

function updateMultiplayerRoom(room) {
  multiplayer.roomCode = room.code || "";
  multiplayer.status = room.status || "waiting";
  multiplayer.viewerSeat = room.viewerSeat || multiplayer.viewerSeat;
  multiplayer.players = normalizeRemotePlayers(Array.isArray(room.players) ? room.players : []);
  multiplayer.game = room.game || null;
  if (!["disconnected", "hostLeft"].includes(multiplayer.status)) {
    multiplayerDisconnectNoticeShown = false;
  }
  if (room.hostDisconnected || multiplayer.status === "hostLeft") {
    showHostDisconnectedDialog(room);
  }
  if (multiplayer.game?.phase !== "gameover") {
    multiplayer.gameOverShown = false;
  }

  if (elements.roomCodeInput && multiplayer.roomCode) {
    elements.roomCodeInput.value = multiplayer.roomCode;
  }
  if (multiplayer.game) {
    applyMultiplayerGameState(multiplayer.game);
    if (multiplayer.game.phase && multiplayer.game.phase !== "gameover") {
      closeMultiplayerDialog();
    }
  }
  renderMultiplayerPanel();
}

function applyMultiplayerGameState(remoteGame) {
  game.playerCount = remoteGame.players?.length || 2;
  game.difficulty = "quick";
  game.phase = ["select", "confirmReveal", "reveal", "instant", "gameover"].includes(remoteGame.phase) ? remoteGame.phase : "select";
  game.round = remoteGame.round || 1;
  syncMatchTimer(remoteGame);
  game.deck = Array.from({ length: remoteGame.deckCount || 0 }, (_, index) => ({ id: `remote-deck-${index}` }));
  game.discard = Array.from({ length: remoteGame.discardCount || 0 }, (_, index) => ({ id: `remote-discard-${index}` }));
  game.activePlayerIndex = getRemoteActivePlayerIndex(remoteGame);
  const remotePlayers = normalizeRemotePlayers(remoteGame.players || []);
  game.players = remotePlayers.map((player) => ({
    name: player.name,
    isHuman: player.seat === remoteGame.viewerSeat,
    isComputer: player.seat !== remoteGame.viewerSeat,
    hand: (player.hand || []).map(normalizeRemoteCard),
    fieldCards: [],
    scorePile: Array.from({ length: player.scoreCount || 0 }, (_, index) => (player.scorePile?.[index] ? normalizeRemoteCard(player.scorePile[index]) : { id: `score-${player.seat}-${index}`, name: "Point", type: "normal", color: "score", image: CARD_BACK })),
    chosenCard: player.chosenCard ? normalizeRemoteCard(player.chosenCard) : null,
    skippedSelection: Boolean(player.passed),
    revealConfirmed: Boolean(player.revealConfirmed),
    instantPlayed: false,
    remoteSeat: player.seat,
  }));
  elements.battleLog.innerHTML = "";
  (remoteGame.log || []).slice().reverse().forEach((entry) => addLog(entry));
  if (remoteGame.phase && remoteGame.phase !== "gameover") {
    playLoopingMusic("playtime", { volume: 0.36 });
  }
  if (remoteGame.phase === "gameover") {
    const winners = game.players.filter((player) => remoteGame.winners?.includes(player.remoteSeat));
    const bestScore = Math.max(0, ...game.players.map((player) => player.scorePile.length));
    render();
    if (!multiplayer.gameOverShown) {
      multiplayer.gameOverShown = true;
      playMultiplayerGameOverSound(remoteGame);
      showGameOverDialog(winners.length ? winners : game.players, bestScore);
    }
    return;
  }
  document.body.classList.remove("menu-open");
  render();
  fitBoardToViewport();
}

function normalizeRemoteCard(card) {
  return {
    id: card.id,
    name: card.name,
    type: card.type,
    color: card.color,
    image: card.image || CARD_BACK,
    destroyed: Boolean(card.destroyed),
    captured: Boolean(card.captured),
  };
}

function normalizeRemotePlayers(players) {
  return players.map((player) => ({
    ...player,
    name: normalizeRemotePlayerName(player),
  }));
}

function normalizeRemotePlayerName(player) {
  const seat = Number(player?.seat) || 1;
  const name = String(player?.name || "").trim().replace(/\s+/g, " ");
  if (!name || /^Joueur(?:\s*1)?$/i.test(name)) {
    return `Joueur ${seat}`;
  }
  return name;
}

function getRemoteActivePlayerIndex(remoteGame) {
  const players = remoteGame.players || [];
  if (remoteGame.phase === "confirmReveal") {
    const ownIndex = players.findIndex((player) => player.seat === remoteGame.viewerSeat);
    if (ownIndex >= 0 && !players[ownIndex].revealConfirmed) {
      return ownIndex;
    }
    const nextIndex = players.findIndex((player) => !player.revealConfirmed);
    return Math.max(0, nextIndex);
  }
  return Math.max(0, players.findIndex((player) => player.seat === remoteGame.activeSeat));
}

function playMultiplayerGameOverSound(remoteGame) {
  const viewerSeat = remoteGame.viewerSeat || multiplayer.viewerSeat;
  if (!viewerSeat) {
    return;
  }
  const viewerWon = Array.isArray(remoteGame.winners) && remoteGame.winners.includes(viewerSeat);
  stopSound("playtime");
  stopSound("loading");
  playSound(viewerWon ? "victory" : "defeat", { restart: true });
}

function updateMultiplayerStatus(status) {
  multiplayer.status = status;
  renderMultiplayerPanel();
}

function showMultiplayerDisconnectNotice(room = {}) {
  if (room.hostDisconnected || room.status === "hostLeft") {
    showHostDisconnectedDialog(room);
    return;
  }
  if (multiplayerDisconnectNoticeShown) {
    return;
  }
  multiplayerDisconnectNoticeShown = true;
  const disconnectedName = room.disconnectedName || "Un joueur";
  updateMultiplayerStatus(`${disconnectedName} est deconnecte`);
  addLog(`${disconnectedName} est deconnecte. Attente de reconnexion.`);
}

function showHostDisconnectedDialog(room = {}) {
  if (multiplayerDisconnectNoticeShown) {
    return;
  }
  multiplayerDisconnectNoticeShown = true;
  const hostName = room.disconnectedName || "L'hôte";
  updateMultiplayerStatus(`${hostName} a quitté la partie`);
  addLog(`${hostName} a quitté. La partie multi est arrêtée.`);
  stopSound("playtime");
  if (elements.hostDisconnectTitle) {
    elements.hostDisconnectTitle.textContent = "L'hôte a quitté";
  }
  if (elements.hostDisconnectSummary) {
    elements.hostDisconnectSummary.textContent = `${hostName} était l'hôte. Quitte cette partie et recrée une room pour continuer.`;
  }
  if (elements.hostDisconnectDialog && !elements.hostDisconnectDialog.open) {
    elements.hostDisconnectDialog.showModal();
  }
}

function quitMultiplayerAfterHostLeft() {
  elements.hostDisconnectDialog?.close();
  if (multiplayerSocket?.connected && multiplayer.roomCode) {
    multiplayerSocket.emit("leaveRoom");
  }
  resetToSetup();
  openMultiplayerDialog();
}

function renderMultiplayerPanel() {
  const playerOne = multiplayer.players.find((player) => player.seat === 1);
  const playerTwo = multiplayer.players.find((player) => player.seat === 2);
  const playerThree = multiplayer.players.find((player) => player.seat === 3);
  const playerFour = multiplayer.players.find((player) => player.seat === 4);
  const connectedPlayers = multiplayer.players.filter((player) => player.connected !== false);
  const canStartRoom = Boolean(playerOne?.connected !== false && connectedPlayers.length >= 2 && multiplayer.viewerSeat === 1 && !["playing", "disconnected"].includes(multiplayer.status));
  const statusLabels = {
    waiting: "En attente de joueurs",
    ready: `${connectedPlayers.length} joueurs connectes`,
    playing: "Partie en cours",
    started: "Partie reseau prete",
    offline: "Solo hors serveur",
    disconnected: "Joueur deconnecte",
    hostLeft: "Hôte deconnecte",
  };

  if (elements.roomStatusLabel) {
    elements.roomStatusLabel.textContent = statusLabels[multiplayer.status] || multiplayer.status || "Solo hors serveur";
  }
  if (elements.roomCodeLabel) {
    elements.roomCodeLabel.textContent = `Code: ${multiplayer.roomCode || "--"}`;
  }
  if (elements.roomPlayerOne) {
    elements.roomPlayerOne.textContent = `Siege 1 · ${playerOne?.name || "--"}${playerOne?.connected === false ? " · deconnecte" : ""}`;
    elements.roomPlayerOne.classList.toggle("room-seat-filled", Boolean(playerOne && playerOne.connected !== false));
    elements.roomPlayerOne.classList.toggle("room-seat-disconnected", Boolean(playerOne?.connected === false));
  }
  if (elements.roomPlayerTwo) {
    elements.roomPlayerTwo.textContent = `Siege 2 · ${playerTwo?.name || "--"}${playerTwo?.connected === false ? " · deconnecte" : ""}`;
    elements.roomPlayerTwo.classList.toggle("room-seat-filled", Boolean(playerTwo && playerTwo.connected !== false));
    elements.roomPlayerTwo.classList.toggle("room-seat-disconnected", Boolean(playerTwo?.connected === false));
  }
  if (elements.roomPlayerThree) {
    elements.roomPlayerThree.textContent = `Siege 3 · ${playerThree?.name || "--"}${playerThree?.connected === false ? " · deconnecte" : ""}`;
    elements.roomPlayerThree.classList.toggle("room-seat-filled", Boolean(playerThree && playerThree.connected !== false));
    elements.roomPlayerThree.classList.toggle("room-seat-disconnected", Boolean(playerThree?.connected === false));
  }
  if (elements.roomPlayerFour) {
    elements.roomPlayerFour.textContent = `Siege 4 · ${playerFour?.name || "--"}${playerFour?.connected === false ? " · deconnecte" : ""}`;
    elements.roomPlayerFour.classList.toggle("room-seat-filled", Boolean(playerFour && playerFour.connected !== false));
    elements.roomPlayerFour.classList.toggle("room-seat-disconnected", Boolean(playerFour?.connected === false));
  }
  if (elements.roomStartButton) {
    elements.roomStartButton.disabled = !canStartRoom;
    elements.roomStartButton.textContent = canStartRoom
      ? "Mélanger et distribuer"
      : multiplayer.status === "disconnected"
        ? "Attente reconnexion"
      : multiplayer.viewerSeat === 2
        ? "Attente de l'hôte"
        : connectedPlayers.length < 2
          ? "Attente de joueurs"
          : "Attente de l'hôte";
  }
  renderMultiplayerDebug(playerOne, playerTwo, connectedPlayers);
  renderRoomQrCode();
}

function renderMultiplayerDebug(playerOne, playerTwo, connectedPlayers = multiplayer.players.filter((player) => player.connected !== false)) {
  const transportLabel = multiplayerTransport === "socket"
    ? (multiplayerSocket?.connected ? `Socket ${serverConnectionLabel()}` : `Socket coupe ${serverConnectionLabel()}`)
    : multiplayerTransport === "http"
      ? `HTTP ${serverConnectionLabel()}`
      : "Aucun serveur";
  const viewerLabel = multiplayer.viewerSeat ? `Joueur ${multiplayer.viewerSeat}` : "Spectateur";
  const remoteGame = multiplayer.game;
  const activePlayer = remoteGame?.players?.find((player) => player.seat === remoteGame.activeSeat);
  const phaseLabel = remoteGame
    ? `${remoteGame.phase || "lobby"} / ronde ${remoteGame.round || 0}`
    : "Lobby";
  let actionLabel = "Heberger ou joindre";
  if (multiplayer.status === "waiting") {
    actionLabel = `Attendre joueurs (${connectedPlayers.length}/4)`;
  } else if (multiplayer.status === "ready") {
    actionLabel = multiplayer.viewerSeat === 1 ? "Pret a lancer" : "Attendre l'hôte";
  } else if (remoteGame?.phase === "select") {
    actionLabel = activePlayer ? `${activePlayer.name} doit jouer` : "Choisir une carte";
  } else if (remoteGame?.phase === "reveal") {
    actionLabel = "Reveal prêt";
  } else if (remoteGame?.phase === "gameover") {
    actionLabel = "Partie terminée";
  } else if (!multiplayer.connected) {
    actionLabel = "Reconnecter serveur";
  }

  if (elements.roomTransportLabel) {
    elements.roomTransportLabel.textContent = transportLabel;
  }
  if (elements.roomViewerLabel) {
    elements.roomViewerLabel.textContent = viewerLabel;
  }
  if (elements.roomPhaseLabel) {
    elements.roomPhaseLabel.textContent = phaseLabel;
  }
  if (elements.roomActionLabel) {
    elements.roomActionLabel.textContent = actionLabel;
  }
}

function serverConnectionLabel() {
  if (!multiplayerApiBase) {
    return "page";
  }
  if (multiplayerApiBase.includes("127.0.0.1")) {
    return "USB";
  }
  return "Wi-Fi";
}

function renderRoomQrCode() {
  const shouldShowQr = Boolean(multiplayer.roomCode && multiplayer.viewerSeat === 1);
  if (elements.roomQrPanel) {
    elements.roomQrPanel.hidden = !shouldShowQr;
  }
  if (!elements.roomQrImage) {
    return;
  }
  if (!shouldShowQr) {
    elements.roomQrImage.removeAttribute("src");
    if (elements.roomJoinLink) {
      elements.roomJoinLink.textContent = "--";
    }
    return;
  }
  const qrTarget = window.KibakiApp ? "app" : "web";
  const qrUrl = `${multiplayerApiBase}/api/qr?room=${encodeURIComponent(multiplayer.roomCode)}&target=${qrTarget}`;
  if (elements.roomQrImage.getAttribute("src") !== qrUrl) {
    elements.roomQrImage.src = qrUrl;
  }
  elements.roomQrImage.onerror = () => {
    elements.roomQrImage.style.display = "none";
    updateMultiplayerStatus("QR indisponible: utilise le code");
  };
  elements.roomQrImage.onload = () => {
    elements.roomQrImage.style.display = "";
  };
  if (elements.roomJoinLink) {
    const publicBase = getPublicMultiplayerBase();
    elements.roomJoinLink.textContent = window.KibakiApp
      ? `kibaki://join/${multiplayer.roomCode}?server=${encodeURIComponent(publicBase)}`
      : `${publicBase}/?room=${multiplayer.roomCode}&join=1&server=${encodeURIComponent(publicBase)}`;
  }
}

function getPublicMultiplayerBase() {
  return multiplayerPublicBase || multiplayerApiBase || "";
}

async function openRoomScanner() {
  if (!("BarcodeDetector" in window)) {
    updateRoomScannerStatus("Scanner QR non disponible sur ce cell");
    updateMultiplayerStatus("Scanner QR non disponible: entre le code de partie");
    elements.roomCodeInput?.focus();
    return;
  }
  if (!navigator.mediaDevices?.getUserMedia) {
    updateRoomScannerStatus("Caméra non disponible");
    updateMultiplayerStatus("Caméra non disponible: entre le code de partie");
    elements.roomCodeInput?.focus();
    return;
  }

  closeRoomScanner();
  keepScannerAwake(true);
  if (elements.roomScannerPanel) {
    elements.roomScannerPanel.hidden = false;
  }
  updateRoomScannerStatus("Ouverture caméra...");

  try {
    qrScannerStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: { ideal: "environment" } },
      audio: false,
    });
    qrScannerStartedAt = Date.now();
    elements.roomScannerVideo.srcObject = qrScannerStream;
    await elements.roomScannerVideo.play();
    updateRoomScannerStatus("Caméra active: approche le QR KIBAKI");
    qrScannerTimer = window.setTimeout(scanRoomQrFrame, 500);
  } catch (error) {
    closeRoomScanner();
    updateRoomScannerStatus("Caméra refusée ou indisponible");
  }
}

async function scanRoomQrFrame() {
  if (!qrScannerStream || !elements.roomScannerVideo) {
    return;
  }

  try {
    const detector = new BarcodeDetector({ formats: ["qr_code"] });
    const codes = await detector.detect(elements.roomScannerVideo);
    const rawValue = codes.find((code) => code.rawValue)?.rawValue || "";
    const roomCode = extractRoomCode(rawValue);
    if (roomCode) {
      closeRoomScanner();
      elements.roomCodeInput.value = roomCode;
      updateMultiplayerStatus("Code scanné");
      await joinMultiplayerRoom();
      return;
    }
  } catch {
    const elapsed = Date.now() - qrScannerStartedAt;
    updateRoomScannerStatus(elapsed < QR_SCANNER_GRACE_MS ? "Caméra active: cherche le QR..." : "Toujours en scan: approche ou éclaire le QR");
  }

  qrScannerTimer = window.setTimeout(scanRoomQrFrame, QR_SCANNER_INTERVAL_MS);
}

function closeRoomScanner() {
  window.clearTimeout(qrScannerTimer);
  qrScannerTimer = null;
  qrScannerStartedAt = 0;
  keepScannerAwake(false);
  if (qrScannerStream) {
    qrScannerStream.getTracks().forEach((track) => track.stop());
    qrScannerStream = null;
  }
  if (elements.roomScannerVideo) {
    elements.roomScannerVideo.pause();
    elements.roomScannerVideo.srcObject = null;
  }
  if (elements.roomScannerPanel) {
    elements.roomScannerPanel.hidden = true;
  }
}

function keepScannerAwake(active) {
  try {
    if (active) {
      window.KibakiApp?.keepAwake?.(true);
      if (navigator.wakeLock?.request) {
        navigator.wakeLock.request("screen")
          .then((lock) => {
            qrScannerWakeLock = lock;
          })
          .catch(() => undefined);
      }
      return;
    }
    window.KibakiApp?.keepAwake?.(false);
    qrScannerWakeLock?.release?.().catch(() => undefined);
    qrScannerWakeLock = null;
  } catch {
