function getPublicBaseUrl(request = null) {
  const configuredHost = String(process.env.PUBLIC_HOST || "").trim();
  if (configuredHost) {
    return normalizeBaseUrl(configuredHost);
  }

  const requestHost = String(request?.headers?.host || "").trim();
  if (requestHost && !/^localhost(?::|$)/i.test(requestHost) && !/^127\./.test(requestHost)) {
    return `http://${requestHost}`;
  }

  const lanAddress = getLanAddress();
  return `http://${lanAddress || "127.0.0.1"}:${port}`;
}

function normalizeBaseUrl(value) {
  const withProtocol = /^https?:\/\//i.test(value) ? value : `http://${value}`;
  return withProtocol.replace(/\/+$/, "");
}

function getLanAddress() {
  const interfaces = os.networkInterfaces();
  const candidates = [];
  Object.values(interfaces).forEach((entries = []) => {
    entries.forEach((entry) => {
      if (entry.family !== "IPv4" || entry.internal) {
        return;
      }
      if (/^169\.254\./.test(entry.address)) {
        return;
      }
      candidates.push(entry.address);
    });
  });
  return candidates.find((address) => /^192\.168\./.test(address))
    || candidates.find((address) => /^10\./.test(address))
    || candidates.find((address) => /^172\.(1[6-9]|2\d|3[0-1])\./.test(address))
    || candidates[0]
    || "";
}

function createQrPng(joinUrl) {
  const pythonPath = path.join(
    process.env.USERPROFILE || "",
    ".cache",
    "codex-runtimes",
    "codex-primary-runtime",
    "dependencies",
    "python",
    "python.exe",
  );
  if (!fs.existsSync(pythonPath)) {
    return null;
  }

  const script = String.raw`
import sys
from io import BytesIO
from reportlab.graphics.barcode import qr
from PIL import Image, ImageDraw, ImageFont

url = sys.argv[1]
code = qr.QrCodeWidget(url, barLevel='L')
code.qr.make()
count = code.qr.getModuleCount()
scale = 34
quiet = 4
label_h = 0
img_size = (count + quiet * 2) * scale
img = Image.new('RGB', (img_size, img_size + label_h), 'white')
draw = ImageDraw.Draw(img)
for y in range(count):
    for x in range(count):
        if code.qr.isDark(y, x):
            x0 = (x + quiet) * scale
            y0 = (y + quiet) * scale
            draw.rectangle([x0, y0, x0 + scale - 1, y0 + scale - 1], fill='black')
buffer = BytesIO()
img.save(buffer, format='PNG')
sys.stdout.buffer.write(buffer.getvalue())
`;

  const result = spawnSync(pythonPath, ["-c", script, joinUrl], {
    encoding: "buffer",
    maxBuffer: 3_000_000,
    windowsHide: true,
  });
  if (result.status !== 0 || !result.stdout?.length) {
    return null;
  }
  return result.stdout;
}

function sanitizePlayerName(name, seat = 1) {
  const cleanName = String(name || "").trim().replace(/\s+/g, " ").slice(0, 18);
  return cleanName || `Joueur ${seat || 1}`;
}

function createRoomCode(preferredCode = "") {
  const alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
  const cleanPreferredCode = String(preferredCode || "").trim().toUpperCase();
  if (/^KIB[A-Z0-9]{3}$/.test(cleanPreferredCode) && !rooms.has(cleanPreferredCode)) {
    return cleanPreferredCode;
  }

  let code = "";
  do {
    code = "KIB";
    for (let index = 0; index < 3; index += 1) {
      code += alphabet[Math.floor(Math.random() * alphabet.length)];
    }
  } while (rooms.has(code));
  return code;
}

function createClientId() {
  return `client-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 9)}`;
}

function getRequestedClientId(payload) {
  const clientId = String(payload.clientId || "").trim().slice(0, 64);
  return clientId || createClientId();
}

async function handleCreateRoomRequest(request, response) {
  try {
    const payload = JSON.parse(await readBody(request) || "{}");
    createRoomForClient(payload, response);
  } catch (error) {
    sendJson(response, 400, { message: error.message || "Impossible de creer la partie." });
  }
}

function handleCreateRoomQuery(requestUrl, response) {
  createRoomForClient({
    clientId: requestUrl.searchParams.get("clientId"),
    playerName: requestUrl.searchParams.get("playerName"),
    roomCode: requestUrl.searchParams.get("roomCode"),
  }, response, requestUrl);
}

function createRoomForClient(payload, response, requestUrl = null) {
  const clientId = getRequestedClientId(payload);
  const playerName = sanitizePlayerName(payload.playerName, 1);
  const roomCode = createRoomCode(payload.roomCode);
  const room = {
    code: roomCode,
    hostId: clientId,
    players: [{ id: clientId, name: playerName, seat: 1, connected: true }],
    status: "waiting",
  };
  rooms.set(roomCode, room);
  notifyRoomChanged(room);
  const result = {
    clientId,
    room: publicRoom(room, clientId),
  };
  if (requestUrl) {
    sendJsonOrJsonp(requestUrl, response, 200, result);
    return;
  }
  sendJson(response, 200, result);
}

async function handleJoinRoomRequest(request, response) {
  try {
    const payload = JSON.parse(await readBody(request) || "{}");
    joinRoomForClient(payload, response);
  } catch (error) {
    sendJson(response, 400, { message: error.message || "Impossible de rejoindre la partie." });
  }
}

function handleJoinRoomQuery(requestUrl, response) {
  joinRoomForClient({
    clientId: requestUrl.searchParams.get("clientId"),
    playerName: requestUrl.searchParams.get("playerName"),
    roomCode: requestUrl.searchParams.get("roomCode"),
  }, response, requestUrl);
}

function joinRoomForClient(payload, response, requestUrl = null) {
  const clientId = getRequestedClientId(payload);
  const roomCode = String(payload.roomCode || "").trim().toUpperCase();
  if (!/^KIB[A-Z0-9]{3}$/.test(roomCode)) {
    const result = { message: "Code de partie invalide." };
    requestUrl ? sendJsonOrJsonp(requestUrl, response, 400, result) : sendJson(response, 400, result);
    return;
  }
  const room = rooms.get(roomCode);
  if (!room) {
    const result = { message: "Code de partie introuvable." };
    requestUrl ? sendJsonOrJsonp(requestUrl, response, 404, result) : sendJson(response, 404, result);
    return;
  }
  if (room.players.length >= MAX_ROOM_PLAYERS && !room.players.some((player) => player.id === clientId)) {
    const result = { message: "Cette partie est déjà pleine." };
    requestUrl ? sendJsonOrJsonp(requestUrl, response, 409, result) : sendJson(response, 409, result);
    return;
  }

  const existingPlayer = room.players.find((player) => player.id === clientId);
  if (!existingPlayer) {
    room.players.push({
      id: clientId,
      name: sanitizePlayerName(payload.playerName, room.players.length + 1),
      seat: room.players.length + 1,
      connected: true,
    });
  } else {
    existingPlayer.connected = true;
    existingPlayer.name = sanitizePlayerName(payload.playerName, existingPlayer.seat) || existingPlayer.name;
  }
  if (room.players.filter((player) => player.connected).length >= 2) {
    room.status = room.game ? "playing" : "ready";
    room.disconnectedSeat = null;
    room.disconnectedName = "";
  }
  notifyRoomChanged(room);

  const result = {
    clientId,
    room: publicRoom(room, clientId),
  };
  requestUrl ? sendJsonOrJsonp(requestUrl, response, 200, result) : sendJson(response, 200, result);
}

function handleRoomSyncRequest(requestUrl, response) {
  const roomCode = decodeURIComponent(requestUrl.pathname.replace("/api/rooms/", "")).trim().toUpperCase();
  const clientId = String(requestUrl.searchParams.get("clientId") || "");
  if (!/^KIB[A-Z0-9]{3}$/.test(roomCode)) {
    sendJsonOrJsonp(requestUrl, response, 400, { message: "Code de partie invalide." });
    return;
  }
  const room = rooms.get(roomCode);
  if (!room) {
    sendJsonOrJsonp(requestUrl, response, 404, { message: "Code de partie introuvable." });
    return;
  }
  sendJsonOrJsonp(requestUrl, response, 200, {
    clientId,
    room: publicRoom(room, clientId),
  });
}

function handleRoomActionQuery(requestUrl, response) {
  const roomCode = String(requestUrl.searchParams.get("roomCode") || "").trim().toUpperCase();
  const clientId = String(requestUrl.searchParams.get("clientId") || "").trim();
  const action = String(requestUrl.searchParams.get("action") || "").trim();
  const cardId = String(requestUrl.searchParams.get("cardId") || "").trim();
  const room = rooms.get(roomCode);
  if (!room) {
    sendJsonOrJsonp(requestUrl, response, 404, { message: "Code de partie introuvable." });
    return;
  }

  const player = room.players.find((candidate) => candidate.id === clientId);
  if (!player) {
    sendJsonOrJsonp(requestUrl, response, 403, { message: "Joueur introuvable dans cette partie." });
    return;
  }

  const result = applyRoomAction(room, player, action, cardId);
  if (result.ok) {
    notifyRoomChanged(room);
  }
  sendJsonOrJsonp(requestUrl, response, result.ok ? 200 : 400, {
    message: result.message,
    room: publicRoom(room, clientId),
  });
}

function publicRoom(room, viewerId = "") {
  return {
    code: room.code,
    status: room.status,
    hostSeat: room.players.find((player) => player.id === room.hostId)?.seat || 1,
    viewerSeat: room.players.find((player) => player.id === viewerId)?.seat || null,
    disconnectedSeat: room.disconnectedSeat || null,
    disconnectedName: room.disconnectedName || "",
    hostDisconnected: Boolean(room.hostDisconnected || room.status === "hostLeft"),
    players: room.players.map((player) => ({
      name: normalizeSeatPlayerName(player),
      seat: player.seat,
      connected: player.connected !== false,
    })),
    game: room.game ? publicMultiplayerGame(room, viewerId) : null,
  };
}

async function broadcastRoomState(io, room, eventName = "gameStateUpdated") {
  const sockets = await io.in(room.code).fetchSockets();
  sockets.forEach((socket) => {
    socket.emit(eventName, publicRoom(room, socket.data.clientId || socket.id));
  });
}

function notifyRoomChanged(room, eventName = "gameStateUpdated") {
  if (!socketServer || !room?.code) {
    return;
  }
  broadcastRoomState(socketServer, room, eventName).catch(() => undefined);
}

const multiplayerRules = {
  Roche: ["Cutter", "Lezard"],
  Papier: ["Roche", "Spock"],
  Cutter: ["Papier", "Lezard"],
  Lezard: ["Papier", "Spock"],
  Spock: ["Roche", "Cutter"],
  Allumette: ["Dynamite"],
  Bol: ["Allumette"],
  Dynamite: ["Bol", "Roche"],
};

const INITIAL_HAND_SIZE = 4;
const HAND_LIMIT = 5;

const multiplayerCardDefinitions = [
  ["Allumette", "normal", "rouge", "001 ALLUMETTE ROUGE.png"],
  ["Bol", "normal", "blanc", "001 BOL BLANC.png"],
  ["Cutter", "normal", "bleu", "001 CUTTER BLEU.png"],
  ["Dynamite", "normal", "rouge", "001 DYNAMITE ROUGE.png"],
  ["Lezard", "normal", "vert", "001 LEZARD VERT.png"],
  ["Papier", "normal", "blanc", "001 PAPIER BLANC.png"],
  ["Roche", "normal", "vert", "001 ROCHE VERT.png"],
  ["Spock", "normal", "bleu", "001 SPOCK BLEU.png"],
  ["Drill", "instant", "rouge", "001 DRILL ROUGE.png"],
  ["Impact", "instant", "bleu", "001 IMPACT BLEU.png"],
  ["Cle", "instant", "blanc", "001 UNCOMMUN CLE BLANC.png"],
  ["Tournevis", "counter", "multi", "001 TOURNEVIS ROUGE BLEU BLANC.png"],
];

function applyRoomAction(room, player, action, cardId) {
  if (!player?.connected) {
    return { ok: false, message: "Joueur déconnecté." };
  }
  if (action === "start") {
    const connectedPlayers = room.players.filter((candidate) => candidate.connected);
    if (connectedPlayers.length < 2) {
      return { ok: false, message: "Il faut deux joueurs pour lancer le multijoueur local." };
    }
    if (player.id !== room.hostId) {
      return { ok: false, message: "Seul le joueur 1 peut lancer la partie." };
    }
    room.players = connectedPlayers.slice(0, MAX_ROOM_PLAYERS);
    room.players.forEach((roomPlayer, index) => {
      roomPlayer.seat = index + 1;
    });
    room.game = createMultiplayerQuickGame(room);
    room.status = "playing";
    notifyRoomChanged(room, "gameStarted");
    return { ok: true, message: "Partie multi lancee." };
  }
  if (!room.game || room.status !== "playing") {
    return { ok: false, message: "La partie multi n'est pas lancée." };
  }

  const game = room.game;
  const statePlayer = game.players.find((candidate) => candidate.seat === player.seat);
  if (!statePlayer) {
    return { ok: false, message: "Joueur absent de la partie." };
  }

  if (game.phase === "select" && action === "select") {
    if (game.activeSeat !== player.seat) {
      return { ok: false, message: "Ce n'est pas ton tour." };
    }
    const index = statePlayer.hand.findIndex((card) => card.id === cardId);
    const card = statePlayer.hand[index];
    if (!card || card.type !== "normal") {
      return { ok: false, message: "Choisis une carte jouable." };
    }
    statePlayer.chosenCard = statePlayer.hand.splice(index, 1)[0];
    game.log.unshift(`${statePlayer.name} pose une carte.`);
    advanceMultiplayerSelection(game);
    return { ok: true, message: "Carte jouée." };
  }

  if (game.phase === "select" && action === "pass") {
    if (game.activeSeat !== player.seat) {
      return { ok: false, message: "Ce n'est pas ton tour." };
    }
    const discarded = statePlayer.hand.shift();
    if (discarded) {
      game.discard.push(discarded);
      game.log.unshift(`${statePlayer.name} passe et défausse ${discarded.name}.`);
    } else {
      game.log.unshift(`${statePlayer.name} passe.`);
    }
    statePlayer.passed = true;
    advanceMultiplayerSelection(game);
    return { ok: true, message: "Tour passé." };
  }

  if (game.phase === "confirmReveal" && action === "confirmReveal") {
    statePlayer.revealConfirmed = true;
    game.log.unshift(`${statePlayer.name} confirme le reveal.`);
    const allConfirmed = game.players.every((candidate) => candidate.revealConfirmed);
    if (allConfirmed) {
      game.phase = "reveal";
      game.activeSeat = 0;
      game.log.unshift("Reveal: les cartes sont retournees.");
    } else {
      const nextPlayer = game.players.find((candidate) => !candidate.revealConfirmed);
      game.activeSeat = nextPlayer?.seat || 0;
    }
    return { ok: true, message: "Reveal confirme." };
  }

  if (game.phase === "reveal" && (action === "reveal" || action === "resolve")) {
    if (startMultiplayerInstantPhase(game)) {
      return { ok: true, message: "Phase instant lancee." };
    }
    resolveMultiplayerRound(game);
    if (isMultiplayerGameOver(game)) {
      finishMultiplayerQuickGame(game);
      return { ok: true, message: "Partie terminee." };
    }
    prepareNextMultiplayerRound(game);
    return { ok: true, message: "Ronde resolue." };
  }

  if (game.phase === "instant" && action === "instant") {
    if (game.activeSeat !== player.seat) {
      return { ok: false, message: "Ce n'est pas ton instant." };
    }
    const index = statePlayer.hand.findIndex((card) => card.id === cardId);
    const card = statePlayer.hand[index];
    if (!card || card.type !== "instant") {
      return { ok: false, message: "Choisis une carte instant." };
    }
    const target = getValidMultiplayerInstantTargets(game, statePlayer, card)[0];
    if (!target) {
      return { ok: false, message: "Aucune cible valide pour cet instant." };
    }
    statePlayer.hand.splice(index, 1);
    game.discard.push(card);
    target.card.destroyed = true;
    target.card.captured = true;
    statePlayer.scorePile.push(target.card);
    statePlayer.instantPassed = true;
    game.log.unshift(`${card.name} detruit ${target.card.name}; ${statePlayer.name} gagne 1 point.`);
    advanceMultiplayerInstant(game);
    return { ok: true, message: "Instant joue." };
  }

  if (game.phase === "instant" && action === "pass") {
    if (game.activeSeat !== player.seat) {
      return { ok: false, message: "Ce n'est pas ton instant." };
    }
    statePlayer.instantPassed = true;
    game.log.unshift(`${statePlayer.name} ne joue pas d'instant.`);
    advanceMultiplayerInstant(game);
    return { ok: true, message: "Instant passe." };
  }

  return { ok: false, message: "Action multi inconnue." };
}

function createMultiplayerQuickGame(room) {
  const deck = shuffleServerCards(
    multiplayerCardDefinitions.flatMap(([name, type, color, file], index) => {
      const copies = type === "normal" ? 2 : 1;
      return Array.from({ length: copies }, (_, copyIndex) => ({
        id: `m-${Date.now().toString(36)}-${index}-${copyIndex}-${Math.random().toString(36).slice(2, 7)}`,
        name,
        type,
        color,
        image: `./assets/cards/${encodeURIComponent(file)}`,
        destroyed: false,
        captured: false,
      }));
    })
  );
  const players = room.players
    .filter((roomPlayer) => roomPlayer.connected !== false)
    .sort((left, right) => left.seat - right.seat)
    .slice(0, MAX_ROOM_PLAYERS)
    .map((roomPlayer) => ({
    seat: roomPlayer.seat,
    name: roomPlayer.name,
    hand: [],
    scorePile: [],
    fieldCards: [],
    chosenCard: null,
    passed: false,
    revealConfirmed: false,
    instantPassed: false,
  }));

  const dealState = { deck, discard: [], log: [] };
  players.forEach((player) => drawMultiplayerToHandSize(dealState, player, INITIAL_HAND_SIZE));
  drawMultiplayerToFive(dealState, players[0]);

  return {
    mode: "local-duel",
    phase: "select",
    round: 1,
    startedAt: Date.now(),
    finishedAt: 0,
    activeSeat: 1,
    players,
    deck: dealState.deck,
    discard: dealState.discard,
    log: ["Multijoueur local: chaque joueur joue une carte à son tour."],
    winners: [],
  };
}

function advanceMultiplayerSelection(game) {
  while (true) {
    const waitingPlayer = game.players.find((player) => !player.chosenCard && !player.passed);
    if (!waitingPlayer) {
      break;
    }
    drawMultiplayerToFive(game, waitingPlayer);
    if (waitingPlayer.hand.some((card) => card.type === "normal")) {
      game.activeSeat = waitingPlayer.seat;
      return;
    }
    const discarded = waitingPlayer.hand.shift();
    if (discarded) {
      game.discard.push(discarded);
      game.log.unshift(`${waitingPlayer.name} ne trouve aucune carte commune et defausse ${discarded.name}.`);
    } else {
      game.log.unshift(`${waitingPlayer.name} n'a aucune carte a jouer.`);
    }
    waitingPlayer.passed = true;
  }

  game.phase = "confirmReveal";
  game.players.forEach((player) => {
    player.revealConfirmed = false;
  });
  game.activeSeat = game.players[0]?.seat || 0;
  game.log.unshift("Les cartes sont posees. Chaque joueur doit confirmer le reveal.");
}

function prepareNextMultiplayerRound(game) {
  game.round += 1;
  game.players.forEach((player) => {
    player.chosenCard = null;
    player.passed = false;
    player.revealConfirmed = false;
    player.instantPassed = false;
  });
  const nextPlayer = game.players[0];
  game.activeSeat = nextPlayer?.seat || 1;
  if (nextPlayer) {
    drawMultiplayerToFive(game, nextPlayer);
  }
  game.phase = "select";
}

function drawMultiplayerToFive(game, player) {
  drawMultiplayerToHandSize(game, player, HAND_LIMIT);
}

function drawMultiplayerToHandSize(game, player, handSize) {
  while (player?.hand.length < handSize && getMultiplayerDrawableCardCount(game) > 0) {
    refillMultiplayerDeckFromDiscardIfNeeded(game);
    const drawnCard = game.deck.pop();
    if (!drawnCard) {
      break;
    }
    player.hand.push({
      ...drawnCard,
      destroyed: false,
      captured: false,
    });
  }
}

function refillMultiplayerDeckFromDiscardIfNeeded(game) {
  if (game.deck.length > 0 || game.discard.length === 0) {
    return;
  }
  game.deck = shuffleServerCards(
    game.discard.map((card) => ({
      ...card,
      destroyed: false,
      captured: false,
    }))
  );
  game.discard = [];
  game.log.unshift("Paquet vide: la defausse commune est remelangee.");
}

function getMultiplayerDrawableCardCount(game) {
  return game.deck.length + game.discard.length;
}

function resolveMultiplayerRound(game) {
  const played = game.players.filter((player) => player.chosenCard && !player.chosenCard.destroyed && !player.chosenCard.captured);
  if (played.length === 0) {
    game.log.unshift("Tout le monde a passe: calcul des points.");
    return;
  }

  if (played.length < 2) {
    game.discard.push(played[0].chosenCard);
    game.log.unshift(`${played[0].name} est seul a jouer: ${played[0].chosenCard.name} va a la defausse.`);
    return;
  }

  const playersInOrder = [...game.players].sort((left, right) => left.seat - right.seat);
  playersInOrder.forEach((attacker, index) => {
    const attackerCard = attacker.chosenCard;
    if (!attackerCard || attackerCard.destroyed || attackerCard.captured) {
      return;
    }

    const defender = playersInOrder[(index + 1) % playersInOrder.length];
    const defenderCard = defender.chosenCard;
    if (!defenderCard || defenderCard.destroyed || defenderCard.captured) {
      return;
    }

    if (multiplayerBeats(attackerCard, defenderCard)) {
      defenderCard.captured = true;
      attacker.scorePile.push(defenderCard);
      game.log.unshift(`${attacker.name} capture ${defenderCard.name} de ${defender.name}.`);
    }
  });

  game.players.forEach((player) => {
    const card = player.chosenCard;
    if (card && !card.captured && !card.destroyed) {
      game.discard.push(card);
    }
  });

  if (!game.players.some((player) => player.chosenCard?.captured)) {
    const names = played.map((player) => player.chosenCard.name).join(" / ");
    game.log.unshift(`${names}: aucune capture, defausse commune.`);
  }
}
function startMultiplayerInstantPhase(game) {
  game.players.forEach((player) => {
    player.instantPassed = false;
  });
  const nextPlayer = game.players.find((player) => hasPlayableMultiplayerInstant(game, player));
  if (!nextPlayer) {
    return false;
  }
  game.phase = "instant";
  game.activeSeat = nextPlayer.seat;
  game.log.unshift("Phase instants: joue une carte instant ou passe.");
  return true;
}

function advanceMultiplayerInstant(game) {
  const nextPlayer = game.players.find((player) => !player.instantPassed && hasPlayableMultiplayerInstant(game, player));
  if (nextPlayer) {
    game.activeSeat = nextPlayer.seat;
    return;
  }
  resolveMultiplayerRound(game);
  if (isMultiplayerGameOver(game)) {
    finishMultiplayerQuickGame(game);
    return;
  }
  prepareNextMultiplayerRound(game);
}

function hasPlayableMultiplayerInstant(game, player) {
  return player.hand.some((card) => card.type === "instant" && getValidMultiplayerInstantTargets(game, player, card).length > 0);
}

function getValidMultiplayerInstantTargets(game, actingPlayer, actionCard) {
  return game.players
    .filter((player) => player.seat !== actingPlayer.seat)
    .map((player) => ({ owner: player, card: player.chosenCard }))
    .filter((target) =>
      target.card &&
      !target.card.destroyed &&
      !target.card.captured &&
      target.card.color === actionCard.color
    );
}

function isMultiplayerGameOver(game) {
  return getMultiplayerDrawableCardCount(game) === 0;
}

function finishMultiplayerQuickGame(game) {
  game.phase = "gameover";
  game.finishedAt = Date.now();
  const bestScore = Math.max(...game.players.map((player) => player.scorePile.length));
  game.winners = game.players.filter((player) => player.scorePile.length === bestScore).map((player) => player.seat);
  game.activeSeat = 0;
  game.log.unshift(game.winners.length === 1 ? `${game.players.find((player) => player.seat === game.winners[0]).name} gagne le duel multi.` : "Égalité en duel multi.");
}

function multiplayerBeats(attacker, defender) {
  return Boolean(attacker && defender && multiplayerRules[attacker.name]?.includes(defender.name));
}

function publicMultiplayerGame(room, viewerId) {
  const viewerSeat = room.players.find((player) => player.id === viewerId)?.seat || null;
  const game = room.game;
  return {
    mode: game.mode,
    phase: game.phase,
    round: game.round,
    startedAt: game.startedAt || 0,
    elapsedMs: Math.max(0, (game.finishedAt || Date.now()) - (game.startedAt || Date.now())),
    activeSeat: game.activeSeat,
    viewerSeat,
    deckCount: game.deck.length,
    discardCount: game.discard.length,
    log: game.log.slice(0, 12),
    winners: game.winners,
    players: game.players.map((player) => ({
      seat: player.seat,
      name: normalizeSeatPlayerName(player),
      hand: player.seat === viewerSeat ? player.hand : player.hand.map((card) => hiddenMultiplayerCard(card.id)),
      handCount: player.hand.length,
      scoreCount: player.scorePile.length,
      scorePile: player.scorePile.slice(-5),
      fieldCards: [],
      chosenCard: publicChosenMultiplayerCard(game, player),
      hasChosen: Boolean(player.chosenCard),
      passed: player.passed,
      revealConfirmed: Boolean(player.revealConfirmed),
    })),
  };
}

function normalizeSeatPlayerName(player) {
  const seat = Number(player?.seat) || 1;
  const name = String(player?.name || "").trim().replace(/\s+/g, " ");
  if (!name || /^Joueur(?:\s*1)?$/i.test(name)) {
    return `Joueur ${seat}`;
  }
  return name;
}

function publicChosenMultiplayerCard(game, player) {
  if (!player.chosenCard) {
    return null;
  }
  if (["reveal", "instant", "gameover"].includes(game.phase)) {
    return player.chosenCard;
  }
  return hiddenMultiplayerCard(`chosen-${player.seat}`);
}

function hiddenMultiplayerCard(id) {
  return {
    id,
    name: "Carte cachee",
    type: "hidden",
    color: "hidden",
    image: "./assets/cards/back.png",
  };
}

function shuffleServerCards(cards) {
  const shuffled = [...cards];
  for (let index = shuffled.length - 1; index > 0; index -= 1) {
    const swapIndex = Math.floor(Math.random() * (index + 1));
    [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
  }
  return shuffled;
}

function leaveSocketRoom(io, socket) {
  const roomCode = socket.data.roomCode;
  const clientId = socket.data.clientId || socket.id;
  const room = rooms.get(roomCode);
  if (!room) {
    return;
  }

  const leavingPlayer = room.players.find((player) => player.id === clientId);
  if (leavingPlayer) {
    leavingPlayer.connected = false;
    leavingPlayer.socketId = "";
  }
  socket.leave(roomCode);
  socket.data.roomCode = "";
  socket.data.clientId = "";
  socket.data.seat = null;

  if (!room.players.some((player) => player.connected)) {
    rooms.delete(roomCode);
    return;
  }

  const hostDisconnected = room.hostId === clientId;
  room.status = hostDisconnected ? "hostLeft" : "disconnected";
  room.disconnectedSeat = leavingPlayer?.seat || null;
  room.disconnectedName = normalizeSeatPlayerName(leavingPlayer) || "Un joueur";
  room.hostDisconnected = hostDisconnected;
  io.to(roomCode).emit("playerDisconnected", publicRoom(room));
  io.to(roomCode).emit("gameStateUpdated", publicRoom(room));
}

function readBody(request) {
  return new Promise((resolve, reject) => {
    let body = "";
    request.on("data", (chunk) => {
      body += chunk;
      if (body.length > 1_000_000) {
        request.destroy();
        reject(new Error("Message trop long."));
      }
    });
    request.on("end", () => resolve(body));
    request.on("error", reject);
  });
}

async function handleChatRequest(request, response) {
  if (!openAiApiKey) {
    sendJson(response, 200, {
      answer: [
        "Le serveur local fonctionne, mais il manque la cle API OpenAI.",
        "",
        "Ferme la fenêtre du serveur, relance START_CHATGPT_LOCAL.cmd, puis colle ta clé API quand il la demande.",
        "",
        "Analyse rapide sans ChatGPT:",
        "- Les ordinateurs ne trichent pas avec les cartes.",
        "- Ils profitaient surtout de reflexes trop constants: instants valides et contres frequents.",
        "- J'ai baissé leurs chances d'instant à 28% et de contre à 45%.",
      ].join("\n"),
      missingKey: true,
    });
    return;
  }

  try {
    const body = JSON.parse(await readBody(request) || "{}");
    const message = String(body.message || "").trim();
    const gameState = body.gameState || null;

    if (!message) {
      sendJson(response, 400, { error: "Message vide." });
      return;
    }

    const apiResponse = await fetch("https://api.openai.com/v1/responses", {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${openAiApiKey}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        model: openAiModel,
        instructions: [
          "Tu es l'assistant local de KIBAKI Duel.",
          "Reponds en francais quebecois simple.",
          "Aide à expliquer les règles, analyser l'équilibrage et proposer des changements concrets.",
          "Ne prétends pas jouer à la place du joueur si l'état de partie est incomplet.",
        ].join(" "),
        input: gameState
          ? `${message}\n\nEtat de partie JSON:\n${JSON.stringify(gameState, null, 2)}`
          : message,
      }),
    });

    const data = await apiResponse.json();
    if (!apiResponse.ok) {
      sendJson(response, apiResponse.status, { error: data.error?.message || "Erreur OpenAI." });
      return;
    }

    sendJson(response, 200, {
      answer: data.output_text || extractResponseText(data) || "",
      id: data.id,
      model: openAiModel,
    });
  } catch (error) {
    sendJson(response, 500, { error: error.message || "Erreur serveur." });
  }
}

function extractResponseText(data) {
  return (data.output || [])
    .flatMap((item) => item.content || [])
    .filter((content) => content.type === "output_text")
    .map((content) => content.text)
    .join("\n");
}

