function preloadGameAssets(onProgress) {
  const assets = getPreloadAssets();
  const fontPromise = document.fonts?.load("700 16px Neuropol");
  let loaded = 0;
  const total = assets.length + (fontPromise ? 1 : 0);
  const report = () => onProgress?.({ loaded, total });
  const markLoaded = () => {
    loaded += 1;
    report();
  };

  const assetLoads = assets.map((src) =>
    preloadAsset(src)
      .catch(() => undefined)
      .finally(markLoaded)
  );

  if (fontPromise) {
    assetLoads.push(withTimeout(fontPromise, 5000).catch(() => undefined).finally(markLoaded));
  }

  report();
  return Promise.allSettled(assetLoads);
}

function withTimeout(promise, milliseconds) {
  return Promise.race([promise, delay(milliseconds)]);
}

function delay(milliseconds) {
  return new Promise((resolve) => {
    window.setTimeout(resolve, milliseconds);
  });
}

function preloadAsset(src) {
  return isAudioAsset(src) ? preloadAudio(src) : preloadImage(src);
}

function isAudioAsset(src) {
  return /\.(ogg|mp3|wav)(?:[?#].*)?$/i.test(src);
}

function preloadAudio(src) {
  return new Promise((resolve) => {
    const audio = new Audio();
    let settled = false;
    const done = () => {
      if (settled) {
        return;
      }
      settled = true;
      audio.removeEventListener("canplaythrough", done);
      audio.removeEventListener("loadeddata", done);
      audio.removeEventListener("error", done);
      resolve(audio);
    };

    audio.preload = "auto";
    audio.addEventListener("canplaythrough", done, { once: true });
    audio.addEventListener("loadeddata", done, { once: true });
    audio.addEventListener("error", done, { once: true });
    audio.src = src;
    audio.load();
    window.setTimeout(done, 5000);
  });
}

function preloadImage(src) {
  if (preloadedImages.has(src)) {
    return Promise.resolve(preloadedImages.get(src));
  }

  return new Promise((resolve) => {
    const image = new Image();
    let settled = false;
    const finish = (result) => {
      if (settled) {
        return;
      }
      settled = true;
      window.clearTimeout(timer);
      resolve(result);
    };
    const timer = window.setTimeout(() => finish(undefined), 4500);

    image.decoding = "async";
    image.loading = "eager";
    image.fetchPriority = "high";
    image.onload = () => {
      const decoded = image.decode ? image.decode().catch(() => undefined) : Promise.resolve();
      withTimeout(decoded, 700).finally(() => {
        preloadedImages.set(src, image);
        finish(image);
      });
    };
    image.onerror = () => finish(undefined);
    image.src = src;
    if (image.complete && image.naturalWidth > 0) {
      preloadedImages.set(src, image);
      finish(image);
    }
  });
}

