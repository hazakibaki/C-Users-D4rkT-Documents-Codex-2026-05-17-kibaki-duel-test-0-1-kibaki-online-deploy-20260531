function getOrCreateMultiplayerClientId() {
  const storageKey = "kibakiMultiplayerClientId";
  try {
    const existingId = localStorage.getItem(storageKey);
    if (existingId) {
      return existingId;
    }
    const newId = `client-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 9)}`;
    localStorage.setItem(storageKey, newId);
    return newId;
  } catch {
    return `client-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 9)}`;
  }
}

function prefillRoomCodeFromUrl() {
  try {
    const params = new URLSearchParams(location.search);
    const serverBase = normalizeMultiplayerBaseUrl(params.get("server"));
    if (serverBase) {
      rememberMultiplayerServer(serverBase);
      updateMultiplayerStatus(`Serveur Wi-Fi: ${serverBase.replace(/^https?:\/\//i, "")}`);
    }
    const roomCode = normalizeRoomCode(params.get("room"));
    if (roomCode && elements.roomCodeInput) {
      elements.roomCodeInput.value = roomCode;
      updateMultiplayerStatus("Code de partie recu");
    }
    return Boolean(roomCode && params.get("join") === "1");
  } catch {
    return false;
  }
}

function shouldAutoJoinRoomFromUrl() {
  try {
    const params = new URLSearchParams(location.search);
    return Boolean(normalizeRoomCode(params.get("room")) && params.get("join") === "1");
  } catch {
    return false;
  }
}

function normalizeRoomCode(value) {
  const roomCode = String(value || "").trim().toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 6);
  return ROOM_CODE_PATTERN.test(roomCode) ? roomCode : "";
}

function getRoomCodeInputValue() {
  return normalizeRoomCode(elements.roomCodeInput?.value);
}

function handleInvalidRoomCodeInput() {
  const rawCode = String(elements.roomCodeInput?.value || "").trim().toUpperCase();
  if (rawCode && elements.roomCodeInput) {
    elements.roomCodeInput.value = "";
  }
  updateMultiplayerStatus(rawCode ? "Code invalide: scanne le QR ou entre KIB + 3 caracteres" : "Entre un code de partie");
  return false;
}

async function createMultiplayerRoom() {
  if (shouldUseHttpMultiplayer()) {
    await createHttpMultiplayerRoom();
    return;
  }

  if (!multiplayerSocket?.connected) {
    updateMultiplayerStatus("Lance le serveur local pour creer une partie");
    return;
  }

  multiplayerSocket.emit("createRoom", { clientId: multiplayerClientId, playerName: getMultiplayerPlayerName() });
}

async function joinMultiplayerRoom() {
  if (shouldUseHttpMultiplayer()) {
    await joinHttpMultiplayerRoom();
    return;
  }

  if (!multiplayerSocket?.connected) {
    updateMultiplayerStatus("Lance le serveur local pour rejoindre une partie");
    return;
  }

  const roomCode = getRoomCodeInputValue();
  if (!roomCode) {
    handleInvalidRoomCodeInput();
    return;
  }

  multiplayerSocket.emit("joinRoom", {
    clientId: multiplayerClientId,
    roomCode,
    playerName: getMultiplayerPlayerName(),
  });
}

async function joinMultiplayerFromPrimaryButton() {
  const rawCode = String(elements.roomCodeInput?.value || "").trim();
  const roomCode = normalizeRoomCode(rawCode);
  if (roomCode) {
    elements.roomCodeInput.value = roomCode;
    await joinMultiplayerRoom();
    return;
  }
  if (rawCode && elements.roomCodeInput) {
    elements.roomCodeInput.value = "";
    updateMultiplayerStatus("Code invalide: ouverture du scanner");
