function getAdjustedVolume(name, baseVolume = 1) {
  if (audioSettings.muted) {
    return 0;
  }
  const groupVolume = MUSIC_SOUND_NAMES.has(name) ? audioSettings.musicVolume : audioSettings.effectsVolume;
  return Math.max(0, Math.min(1, baseVolume * groupVolume));
}

