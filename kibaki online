  border-radius: 8px;
  background:
    linear-gradient(135deg, rgba(21, 150, 255, 0.96), rgba(255, 51, 45, 0.92)),
    #0a4fbd;
  color: #ffffff;
  cursor: pointer;
  font-size: 1rem;
  font-weight: 900;
  letter-spacing: 0;
  text-align: center;
  text-transform: uppercase;
  box-shadow:
    0 0 0 4px rgba(21, 150, 255, 0.16),
    0 0 32px rgba(21, 150, 255, 0.78),
    inset 0 0 18px rgba(255, 255, 255, 0.24);
}

.action-button small {
  color: rgba(255, 255, 255, 0.82);
  font-size: 0.55rem;
  font-weight: 900;
  line-height: 1;
  text-transform: uppercase;
}

.action-button:hover {
  transform: translateX(-50%) translateY(-2px);
  box-shadow:
    0 0 0 4px rgba(255, 208, 90, 0.2),
    0 0 42px rgba(255, 208, 90, 0.78),
    inset 0 0 18px rgba(255, 255, 255, 0.24);
}

.action-button:disabled {
  cursor: not-allowed;
  filter: grayscale(0.5);
  opacity: 0.62;
}

.hint {
  color: var(--muted);
}

.rules-dialog,
.card-zoom-dialog,
.game-over-dialog,
.host-disconnect-dialog,
.multiplayer-dialog {
  width: min(760px, calc(100% - 28px));
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #081225;
}

.rules-dialog::backdrop,
.card-zoom-dialog::backdrop,
.game-over-dialog::backdrop,
.host-disconnect-dialog::backdrop,
.multiplayer-dialog::backdrop {
  background: rgba(0, 0, 0, 0.72);
}

.multiplayer-dialog {
  width: min(760px, calc(100% - 24px));
  max-height: min(92vh, 900px);
  overflow: auto;
  padding: 18px;
  background:
    radial-gradient(circle at 50% 0%, rgba(21, 150, 255, 0.22), transparent 42%),
    #061426;
}

.multiplayer-dialog .multiplayer-panel {
  width: 100%;
  margin: 0;
}

.rules-dialog img,
.card-zoom-dialog img {
  border-radius: 8px;
}

.rules-dialog-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 12px;
  padding: 28px 4px 0;
}

.rules-dialog-cards img {
  width: 100%;
  aspect-ratio: 3209 / 4920;
  max-height: min(70vh, 640px);
  object-fit: contain;
  object-position: center center;
  background: #ffffff;
}

body.is-apk .rules-dialog {
  width: min(92vh, 940px);
  max-height: 90vw;
}

body.is-apk .rules-dialog-cards {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

body.is-apk .rules-dialog-cards img {
  aspect-ratio: 4920 / 3209;
  max-height: min(34vw, 360px);
  object-fit: contain;
}

.golden-rule {
  margin-top: 12px;
  padding: 12px 14px;
  border: 1px solid rgba(255, 208, 90, 0.58);
  border-radius: 8px;
  background:
    linear-gradient(135deg, rgba(255, 208, 90, 0.16), rgba(21, 150, 255, 0.08)),
    rgba(2, 8, 18, 0.92);
}

.golden-rule h2 {
  margin: 0 0 5px;
  color: var(--gold);
  font-size: 1rem;
  font-weight: 900;
  text-transform: uppercase;
}

.golden-rule p {
  margin: 0;
  color: #edf6ff;
  font-size: 0.92rem;
  line-height: 1.35;
}

.card-zoom-dialog {
  width: min(420px, calc(100% - 28px));
  text-align: center;
}

.card-zoom-dialog img {
  width: 100%;
  max-height: min(78vh, 720px);
  object-fit: contain;
  background: #ffffff;
}

.card-zoom-dialog strong {
  display: block;
  margin-top: 10px;
  color: #ffffff;
  font-size: 1rem;
  font-weight: 900;
  text-transform: uppercase;
}

.game-over-dialog,
.host-disconnect-dialog {
  width: min(560px, calc(100% - 28px));
  padding: 0;
}

.game-over-panel {
  display: grid;
  gap: 16px;
  padding: 28px;
  text-align: center;
}

.game-over-panel h2 {
  margin: 0;
  color: var(--gold);
  font-size: clamp(1.9rem, 7vw, 3.1rem);
  line-height: 1;
  text-transform: uppercase;
  text-shadow: 0 0 24px rgba(255, 208, 90, 0.5);
}

.game-over-summary {
  margin: 0;
  color: rgba(235, 247, 255, 0.9);
  font-size: 0.92rem;
  font-weight: 800;
  line-height: 1.45;
}

.game-over-scores {
  display: grid;
  gap: 8px;
}

.game-over-score {
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  min-height: 48px;
  padding: 8px 12px;
  border: 1px solid rgba(210, 235, 255, 0.22);
  border-radius: 7px;
  background: rgba(3, 11, 24, 0.72);
}

.game-over-score.winner {
  border-color: rgba(255, 208, 90, 0.72);
  background: linear-gradient(135deg, rgba(255, 208, 90, 0.24), rgba(3, 11, 24, 0.84));
  box-shadow: 0 0 20px rgba(255, 208, 90, 0.16);
}

.game-over-score span {
  display: grid;
  place-items: center;
  width: 34px;
  height: 26px;
  border-radius: 999px;
  background: rgba(21, 150, 255, 0.22);
  color: #ffffff;
  font-size: 0.72rem;
  font-weight: 900;
}

.game-over-score strong {
  overflow: hidden;
  color: #ffffff;
  font-size: 0.86rem;
  text-align: left;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.game-over-score em {
  color: var(--gold);
  font-size: 0.82rem;
  font-style: normal;
  font-weight: 900;
}

.game-over-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

body.is-apk .game-over-dialog,
body.is-apk .host-disconnect-dialog {
  position: fixed;
  inset: 50% auto auto 50%;
  width: min(86vh, 900px);
  max-width: 86vh;
  max-height: 90vw;
  padding: 0;
  margin: 0;
  transform: translate(-50%, -50%) rotate(90deg);
  transform-origin: center center;
}

body.is-apk .game-over-panel {
  gap: 10px;
  padding: 18px;
}

body.is-apk .game-over-panel h2 {
  font-size: clamp(1.25rem, 5vw, 2.15rem);
}

body.is-apk .game-over-summary {
  font-size: 0.68rem;
  line-height: 1.25;
}

body.is-apk .game-over-scores {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

body.is-apk.players-3 .game-over-scores {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

body.is-apk.players-4 .game-over-scores {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

body.is-apk .game-over-score {
  float: none;
  display: grid;
  grid-template-columns: 1fr;
  width: auto;
  height: auto;
  min-height: 92px;
  margin: 0;
  gap: 5px;
  justify-items: center;
  padding: 8px 6px;
  border-radius: 8px;
  text-align: center;
}

body.is-apk .game-over-score span {
  width: auto;
  min-width: 42px;
  height: 22px;
  padding: 0 8px;
  font-size: 0.56rem;
}

body.is-apk .game-over-score strong {
  max-width: 100%;
  font-size: clamp(0.5rem, 1.9vw, 0.72rem);
  text-align: center;
}

body.is-apk .game-over-score em {
  font-size: 0.62rem;
}

body.is-apk .game-over-actions {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.dialog-close,
.game-over-score {
  float: right;
  width: 32px;
  height: 32px;
  margin-bottom: 10px;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: #061426;
  color: var(--text);
  cursor: pointer;
}

