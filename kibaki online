# KIBAKI Online Server

Serveur web et Socket.IO pour KIBAKI.

## Local

```powershell
npm install
npm start
```

## Fly.io

Ce dossier est prêt pour Fly.io.

Le serveur écoute sur `PORT=8080` dans `fly.toml`.

const http = require("http");
const fs = require("fs");
const path = require("path");
const os = require("os");
const { spawnSync } = require("child_process");

let SocketIOServer = null;
try {
  ({ Server: SocketIOServer } = require("socket.io"));
} catch {
  SocketIOServer = null;
}

const port = Number(process.env.PORT || 4174);
const host = process.env.HOST || "0.0.0.0";
const root = path.resolve(__dirname);
const openAiApiKey = process.env.OPENAI_API_KEY || "";
const openAiModel = process.env.OPENAI_MODEL || "gpt-4.1-mini";
const MAX_ROOM_PLAYERS = 4;
const rooms = new Map();
let socketServer = null;

const mimeTypes = {
  ".html": "text/html; charset=utf-8",
  ".css": "text/css; charset=utf-8",
  ".js": "text/javascript; charset=utf-8",
  ".json": "application/json; charset=utf-8",
  ".png": "image/png",
  ".jpg": "image/jpeg",
  ".jpeg": "image/jpeg",
  ".svg": "image/svg+xml",
  ".ogg": "audio/ogg",
  ".wav": "audio/wav",
};

const server = http.createServer((request, response) => {
  response.setHeader("Access-Control-Allow-Origin", "*");
  response.setHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
  response.setHeader("Access-Control-Allow-Headers", "Content-Type");

  if (request.method === "OPTIONS") {
    response.writeHead(204);
    response.end();
    return;
  }

  const requestUrl = new URL(request.url, `http://${request.headers.host}`);

  if (requestUrl.pathname === "/api/health") {
    sendJson(response, 200, {
      ok: true,
      chatgpt: Boolean(openAiApiKey),
      model: openAiModel,
    });
    return;
  }

  if (requestUrl.pathname === "/api/chat" && request.method === "POST") {
    handleChatRequest(request, response);
    return;
  }

  if (requestUrl.pathname === "/api/multiplayer/health") {
    const publicBaseUrl = getPublicBaseUrl(request);
    sendJson(response, 200, {
      ok: true,
      socket: Boolean(SocketIOServer),
      fallback: true,
      publicBaseUrl,
    });
    return;
  }

  if (requestUrl.pathname === "/api/qr") {
    handleQrRequest(requestUrl, request, response);
    return;
  }

  if (requestUrl.pathname.startsWith("/j/")) {
    handleJoinShortcutRequest(requestUrl, request, response);
    return;
  }

  if (requestUrl.pathname === "/api/rooms" && request.method === "POST") {
    handleCreateRoomRequest(request, response);
    return;
  }

  if (requestUrl.pathname === "/api/rooms/create" && request.method === "GET") {
    handleCreateRoomQuery(requestUrl, response);
    return;
  }

  if (requestUrl.pathname === "/api/rooms/join" && request.method === "POST") {
    handleJoinRoomRequest(request, response);
    return;
  }

  if (requestUrl.pathname === "/api/rooms/join" && request.method === "GET") {
    handleJoinRoomQuery(requestUrl, response);
    return;
  }

  if (requestUrl.pathname === "/api/rooms/action" && request.method === "GET") {
    handleRoomActionQuery(requestUrl, response);
    return;
  }

  if (requestUrl.pathname.startsWith("/api/rooms/") && request.method === "GET") {
    handleRoomSyncRequest(requestUrl, response);
    return;
  }

  if (requestUrl.pathname === "/chat") {
    response.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
    response.end(getChatPage());
    return;
  }

  const safePath = path.normalize(decodeURIComponent(requestUrl.pathname))
    .replace(/^[/\\]+/, "")
    .replace(/^(\.\.[/\\])+/, "");
  const filePath = path.resolve(root, safePath === "" ? "index.html" : safePath);

  if (!filePath.startsWith(root)) {
    response.writeHead(403);
    response.end("Forbidden");
    return;
  }

  fs.readFile(filePath, (error, content) => {
    if (error) {
      response.writeHead(404);
      response.end("Not found");
      return;
    }

    response.writeHead(200, {
      "Content-Type": mimeTypes[path.extname(filePath)] || "application/octet-stream",
    });
    response.end(content);
  });
});

server.listen(port, host, () => {
  console.log(`KIBAKI Duel disponible sur http://127.0.0.1:${port}/`);
  console.log(`ChatGPT local disponible sur http://127.0.0.1:${port}/chat`);
  if (SocketIOServer) {
    console.log("Multijoueur local Socket.IO actif.");
  } else {
    console.log("Multijoueur local HTTP actif sans installation.");
  }
});

if (SocketIOServer) {
  const io = new SocketIOServer(server, {
    cors: {
      origin: "*",
      methods: ["GET", "POST"],
    },
  });
  socketServer = io;

  io.on("connection", (socket) => {
    socket.on("createRoom", (payload = {}) => {
      const playerName = sanitizePlayerName(payload.playerName, 1);
      const clientId = getRequestedClientId(payload) || socket.id;
      const roomCode = createRoomCode();
      const room = {
        code: roomCode,
        hostId: clientId,
        players: [{ id: clientId, socketId: socket.id, name: playerName, seat: 1, connected: true }],
        status: "waiting",
      };
      rooms.set(roomCode, room);
      socket.join(roomCode);
      socket.data.roomCode = roomCode;
      socket.data.clientId = clientId;
      socket.data.seat = 1;
      socket.emit("roomCreated", publicRoom(room, clientId));
      broadcastRoomState(io, room);
    });

    socket.on("joinRoom", (payload = {}) => {
      const roomCode = String(payload.roomCode || "").trim().toUpperCase();
      const room = rooms.get(roomCode);
      if (!room) {
        socket.emit("actionRejected", { message: "Code de partie introuvable." });
        return;
      }
      const clientId = getRequestedClientId(payload) || socket.id;
      if (room.players.length >= MAX_ROOM_PLAYERS && !room.players.some((player) => player.id === clientId)) {
        socket.emit("actionRejected", { message: "Cette partie est déjà pleine." });
        return;
      }

      const existingPlayer = room.players.find((player) => player.id === clientId);
      if (!existingPlayer) {
        room.players.push({
          id: clientId,
          socketId: socket.id,
          name: sanitizePlayerName(payload.playerName, room.players.length + 1),
          seat: room.players.length + 1,
          connected: true,
        });
      } else {
        existingPlayer.socketId = socket.id;
        existingPlayer.connected = true;
        existingPlayer.name = sanitizePlayerName(payload.playerName, existingPlayer.seat) || existingPlayer.name;
      }
      if (room.players.filter((player) => player.connected).length >= 2) {
        room.status = room.game ? "playing" : "ready";
        room.disconnectedSeat = null;
        room.disconnectedName = "";
      }

      socket.join(roomCode);
      socket.data.roomCode = roomCode;
      socket.data.clientId = clientId;
      socket.data.seat = existingPlayer?.seat || room.players.length;
      socket.emit("roomJoined", publicRoom(room, clientId));
      broadcastRoomState(io, room, "playerJoined");
      broadcastRoomState(io, room);
    });

    socket.on("requestSync", () => {
      const room = rooms.get(socket.data.roomCode);
      if (room) {
        socket.emit("gameStateUpdated", publicRoom(room, socket.data.clientId || socket.id));
      }
    });

    socket.on("leaveRoom", () => {
      leaveSocketRoom(io, socket);
    });

    socket.on("startGame", () => {
      const room = rooms.get(socket.data.roomCode);
      if (!room) {
        socket.emit("actionRejected", { message: "Aucune partie active." });
        return;
      }
      if (room.hostId !== (socket.data.clientId || socket.id)) {
        socket.emit("actionRejected", { message: "Seul l'hôte peut lancer la partie." });
        return;
      }
      if (room.players.filter((player) => player.connected).length < 2) {
        socket.emit("actionRejected", { message: "Il manque le Joueur 2." });
        return;
      }
      const result = applyRoomAction(room, room.players.find((player) => player.id === (socket.data.clientId || socket.id)), "start", "");
      if (!result.ok) {
        socket.emit("actionRejected", { message: result.message });
        return;
      }
      broadcastRoomState(io, room, "gameStarted");
      broadcastRoomState(io, room);
    });

    socket.on("playerAction", (payload = {}) => {
      const room = rooms.get(socket.data.roomCode);
      if (!room) {
        socket.emit("actionRejected", { message: "Aucune partie active." });
        return;
      }
      const player = room.players.find((candidate) => candidate.id === (socket.data.clientId || socket.id));
      const result = applyRoomAction(room, player, String(payload.action || ""), String(payload.cardId || ""));
      if (!result.ok) {
        socket.emit("actionRejected", { message: result.message });
        return;
      }
      broadcastRoomState(io, room);
    });

    socket.on("disconnect", () => {
      leaveSocketRoom(io, socket);
    });
  });
}

function sendJson(response, status, payload) {
  response.writeHead(status, { "Content-Type": "application/json; charset=utf-8" });
  response.end(JSON.stringify(payload));
}

function sendJsonOrJsonp(requestUrl, response, status, payload) {
  const callback = String(requestUrl.searchParams.get("callback") || "").trim();
  if (/^[A-Za-z_$][\w$]{0,80}$/.test(callback)) {
    response.writeHead(status, {
      "Content-Type": "text/javascript; charset=utf-8",
      "Cache-Control": "no-store",
    });
    response.end(`${callback}(${JSON.stringify(payload)});`);
    return;
  }
  sendJson(response, status, payload);
}

function handleQrRequest(requestUrl, request, response) {
  const roomCode = String(requestUrl.searchParams.get("room") || "").trim().toUpperCase();
  if (!/^KIB[A-Z0-9]{3}$/.test(roomCode)) {
    sendJson(response, 400, { message: "Code de partie invalide." });
    return;
  }

  const target = String(requestUrl.searchParams.get("target") || "web").trim().toLowerCase();
  const publicBaseUrl = getPublicBaseUrl(request);
  const joinUrl = target === "app"
    ? `kibaki://join/${encodeURIComponent(roomCode)}?server=${encodeURIComponent(publicBaseUrl)}`
    : `${publicBaseUrl}/j/${encodeURIComponent(roomCode)}`;
  const png = createQrPng(joinUrl);
  if (!png) {
    sendJson(response, 500, { message: "Impossible de generer le QR." });
    return;
  }

  response.writeHead(200, {
    "Content-Type": "image/png",
    "Cache-Control": "no-store",
  });
  response.end(png);
}

function handleJoinShortcutRequest(requestUrl, request, response) {
  const roomCode = decodeURIComponent(requestUrl.pathname.replace("/j/", "")).trim().toUpperCase();
  if (!/^KIB[A-Z0-9]{3}$/.test(roomCode)) {
    response.writeHead(400, { "Content-Type": "text/plain; charset=utf-8" });
    response.end("Code de partie invalide.");
    return;
  }

  const publicBaseUrl = getPublicBaseUrl(request);
  const destination = `/?room=${encodeURIComponent(roomCode)}&join=1&server=${encodeURIComponent(publicBaseUrl)}`;
  const fullDestination = `${publicBaseUrl}${destination}`;
  response.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
  response.end(`<!doctype html>
