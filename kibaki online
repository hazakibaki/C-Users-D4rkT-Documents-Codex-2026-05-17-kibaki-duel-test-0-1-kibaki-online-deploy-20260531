function drawToFive(player) {
  drawToHandSize(player, HAND_LIMIT);
}

function drawToHandSize(player, handSize) {
  while (player.hand.length < handSize && (game.deck.length > 0 || game.discard.length > 0)) {
    refillDeckFromDiscardIfNeeded();
    if (game.deck.length === 0) {
      break;
    }
    const drawnCard = game.deck.pop();
    player.hand.push(drawnCard);
    if (player.isHuman && game.phase !== "setup") {
      showDrawReveal(drawnCard, player);
    }
  }
}

function prepareActivePlayerForSelection() {
  if (getDifficultyProfile().quickDeck || game.phase !== "select") {
    return;
  }
  const player = game.players[game.activePlayerIndex];
  if (!player) {
    return;
  }
  drawToFive(player);
  ensureRevealCardInHand(player);
}

function ensureRevealCardInHand(player) {
  if (!player || player.hand.some(canUseCardForReveal)) {
    return true;
  }

  while (!player.hand.some(canUseCardForReveal) && player.hand.length > 0 && canFindRevealCardInCirculation()) {
    const discardIndex = player.hand.findIndex((card) => !canUseCardForReveal(card));
    if (discardIndex < 0) {
      break;
    }
    const discarded = player.hand.splice(discardIndex, 1)[0];
    game.discard.push(discarded);
    drawToFive(player);
  }

  return player.hand.some(canUseCardForReveal);
}

function canFindRevealCardInCirculation() {
  return [...game.deck, ...game.discard].some(canUseCardForReveal);
}

function dealInitialCards() {
  if (!getDifficultyProfile().quickDeck) {
    game.players.forEach((player) => drawToHandSize(player, INITIAL_HAND_SIZE));
    prepareActivePlayerForSelection();
    return;
  }

  let playerIndex = 0;
  while (game.deck.length > 0) {
    game.players[playerIndex % game.players.length].hand.push(game.deck.pop());
    playerIndex += 1;
  }
}

function refillDeckFromDiscardIfNeeded() {
  if (game.deck.length > 0 || game.discard.length === 0) {
    return;
  }

  game.deck = shuffle(
    game.discard.map((card) => ({
      ...card,
      destroyed: false,
      captured: false,
    }))
  );
  game.discard = [];
  addLog("Paquet vide: la défausse commune est remélangée dans le deck.");
}

function selectCard(cardId) {
  if (multiplayer.game && game.phase !== "setup" && game.phase !== "gameover") {
    const action = game.phase === "instant" ? "instant" : "select";
    sendMultiplayerAction(action, cardId).catch((error) => updateMultiplayerStatus(error.message || "Action multi refusée"));
    return;
  }

  const player = game.players[game.activePlayerIndex];
  const cardIndex = player.hand.findIndex((card) => card.id === cardId);

  if (game.phase === "select") {
    ensureRevealCardInHand(player);
    const card = player.hand[cardIndex];
    const hasRevealCard = player.hand.some(canUseCardForReveal);
    if (card && !hasRevealCard) {
      discardAndSkipSelection(player, cardIndex);
      return;
    }

    if (!card || !canUseCardForReveal(card)) {
      addLog(getDifficultyProfile().quickDeck ? "Choisis une carte de reveal." : "Choisis une carte normale pour attaquer.");
      return;
    }
    player.chosenCard = player.hand.splice(cardIndex, 1)[0];
    addLog(`${player.name} pose une carte face cachee.`);
    advanceSelection();
    return;
  }

  if (game.phase === "instant") {
    if ((player.fieldCards || []).some((card) => card.id === cardId)) {
      playFieldInstant(cardId);
      return;
    }
    playInstant(cardId);
    return;
  }

  if (game.phase === "counter") {
    playCounter(cardId);
  }
}

function advanceSelection() {
  game.players.forEach((player) => {
    if (!player.chosenCard && !player.skippedSelection) {
      ensureRevealCardInHand(player);
    }
  });

  const pendingPlayerWithoutReveal = game.players.find((player) =>
    !player.chosenCard &&
    !player.skippedSelection &&
    !player.hand.some(canUseCardForReveal)
  );
  if (pendingPlayerWithoutReveal) {
    discardAndSkipSelection(pendingPlayerWithoutReveal);
    return;
  }

  const nextIndex = game.players.findIndex((player) => !player.chosenCard && !player.skippedSelection);
  if (nextIndex >= 0) {
    game.activePlayerIndex = nextIndex;
    prepareActivePlayerForSelection();
    if (game.players[nextIndex].isComputer) {
      playComputerSelection();
      return;
    }
    render();
    return;
  }

  if (game.phase === "select") {
    game.round += 1;
  }
  game.phase = "instant";
  game.players.forEach((player) => {
    player.instantPlayed = false;
  });
  game.instantOrder = getClockwiseOrder(game.lastRoundWinnerIndex);
  game.instantCursor = 0;
  game.instantActions = [];
  game.quickPasses = 0;
  game.activePlayerIndex = game.instantOrder[0];
  addLog("3 2 1 KIBAKI! Les cartes sont révélées.");
  if (game.players[game.activePlayerIndex].isComputer) {
    playComputerInstantTurn();
    return;
  }
  render();
}

function canUseCardForReveal(handCard) {
  return getDifficultyProfile().quickDeck ? handCard.type !== "counter" : handCard.type === "normal";
}

function playComputerSelection() {
  const player = game.players[game.activePlayerIndex];
  if (game.phase !== "select" || !player?.isComputer) {
    render();
    return;
  }

  const card = chooseComputerAttackCard(player);
  if (!card) {
    discardAndSkipSelection(player);
    return;
  }

  const cardIndex = player.hand.findIndex((handCard) => handCard.id === card.id);
  player.chosenCard = player.hand.splice(cardIndex, 1)[0];
  addLog(`${player.name} pose une carte face cachee.`);
  advanceSelection();
}

function chooseComputerAttackCard(player) {
  const normalCards = player.hand.filter((card) => card.type === "normal");
  if (normalCards.length === 0) {
    return null;
  }

  return normalCards[Math.floor(Math.random() * normalCards.length)];
}

function playInstant(cardId) {
  const player = game.players[game.activePlayerIndex];
  const cardIndex = player.hand.findIndex((card) => card.id === cardId);
  const instant = player.hand[cardIndex];

  if (!instant || (!getDifficultyProfile().quickDeck && player.instantPlayed)) {
    return;
  }

  if (getDifficultyProfile().quickDeck && instant.type === "counter") {
    playQuickCounter(cardId);
    return;
  }

  if (instant.type === "counter") {
    addLog("Tournevis se joue pendant la phase contre-instant.");
    return;
  }

  if (instant.type !== "instant" && !getDifficultyProfile().quickDeck) {
    addLog("Seules les cartes uncommun et le Tournevis se jouent en instant.");
    return;
  }

  const targets = getDifficultyProfile().quickDeck ? getValidQuickActionTargets(instant, player) : getValidInstantTargets(instant, player);
  if (targets.length === 0) {
    addLog(`${instant.name} ne trouve aucune cible ${instant.color}.`);
    render();
    return;
  }

  const target = chooseTargetForInstant(player, targets);
  if (!target) {
    addLog(`${instant.name} ne trouve aucune cible ${instant.color}.`);
    return;
  }
  player.hand.splice(cardIndex, 1);
  player.instantPlayed = !getDifficultyProfile().quickDeck;
  game.quickPasses = 0;
  game.instantActions.push({ player, card: instant, target, cancelled: false });
  playSound("instant", { restart: true });
  addLog(`${player.name} joue ${instant.name} sur ${target.owner.name} (${target.card.name}).`);
  if (player.isComputer) {
    showInstantReveal(instant, `${player.name} joue ${instant.name}`);
  }
  advanceInstant();
}

function playFieldInstant(cardId) {
  const player = game.players[game.activePlayerIndex];
  const fieldCards = player.fieldCards || [];
  const cardIndex = fieldCards.findIndex((card) => card.id === cardId);
  const fieldCard = fieldCards[cardIndex];

  if (!isPlayableFieldCard(player, fieldCard)) {
    render();
    return;
  }

  const targets = getDifficultyProfile().quickDeck ? getValidQuickActionTargets(fieldCard, player) : getValidFieldCardTargets(fieldCard, player);
  const target = chooseTargetForInstant(player, targets);
  if (!target) {
    render();
    return;
  }

  fieldCards.splice(cardIndex, 1);
  player.instantPlayed = !getDifficultyProfile().quickDeck;
  game.quickPasses = 0;
  game.instantActions.push({ player, card: fieldCard, target, cancelled: false, source: "field", counterable: true });
  playSound("instant", { restart: true });
  addLog(`${player.name} joue ${fieldCard.name} depuis sa table comme action instantanée sur ${target.owner.name} (${target.card.name}).`);
  if (player.isComputer) {
    showInstantReveal(fieldCard, `${player.name} joue ${fieldCard.name}`);
  }
  advanceInstant();
}

function findLastUncancelledInstant() {
  for (let index = game.instantActions.length - 1; index >= 0; index -= 1) {
    if (!game.instantActions[index].cancelled) {
      return game.instantActions[index];
    }
  }

  return null;
}

function chooseTargetForInstant(player, targets) {
  const leftPlayer = game.players[getLeftIndex(game.players.indexOf(player))];
  if (player.isComputer) {
    return targets[Math.floor(Math.random() * targets.length)] || null;
  }

  return targets.find((target) => target.owner === leftPlayer) || targets[0] || null;
}

function getValidInstantTargets(instant, actingPlayer = null) {
  return game.players
    .map((player) => ({ owner: player, card: player.chosenCard }))
    .filter((target) =>
      target.owner !== actingPlayer &&
      target.card &&
      !target.card.destroyed &&
      !target.card.captured &&
      target.card.color === instant.color
    );
}

function isPlayableInstantCard(player, card) {
  if (getDifficultyProfile().quickDeck) {
    return Boolean(
      player &&
      card &&
      (
        (card.type === "counter" && findLastUncancelledInstant()) ||
        (card.type !== "counter" && getValidQuickActionTargets(card, player).length > 0)
      )
    );
  }

  return Boolean(
    player &&
    card?.type === "instant" &&
    !player.instantPlayed &&
    getValidInstantTargets(card, player).length > 0
  );
}

function isPlayableFieldCard(player, card) {
  if (getDifficultyProfile().quickDeck) {
    return Boolean(
      player &&
      card?.type === "normal" &&
      getValidQuickActionTargets(card, player).length > 0
    );
  }

  return Boolean(
    player &&
    getDifficultyProfile().fieldActions &&
    card?.type === "normal" &&
    (!player.instantPlayed || getDifficultyProfile().quickDeck) &&
    getValidFieldCardTargets(card, player).length > 0
  );
}

function hasPlayableInstant(player) {
  return Boolean(
    (player?.hand || []).some((card) => isPlayableInstantCard(player, card)) ||
    (player?.fieldCards || []).some((card) => isPlayableFieldCard(player, card))
  );
}

function getValidFieldCardTargets(fieldCard, actingPlayer = null) {
  return game.players
    .flatMap((player) => [
      { owner: player, card: player.chosenCard },
      ...(player.fieldCards || []).map((card) => ({ owner: player, card })),
    ])
    .filter((target) =>
      target.owner !== actingPlayer &&
      target.card &&
      !target.card.destroyed &&
      !target.card.captured &&
      beats(fieldCard, target.card)
    );
}

function getValidQuickActionTargets(actionCard, actingPlayer = null) {
  if (!actionCard || actionCard.type === "counter") {
    return [];
  }

  return game.players
    .flatMap((player) => [
      { owner: player, card: player.chosenCard },
      ...(player.fieldCards || []).map((card) => ({ owner: player, card })),
    ])
    .filter((target) =>
      target.owner !== actingPlayer &&
      target.card &&
      !target.card.destroyed &&
      !target.card.captured &&
      (actionCard.type === "instant" ? target.card.color === actionCard.color : beats(actionCard, target.card))
    );
}

function passInstant() {
  if (game.phase !== "instant") {
    return;
  }
  addLog(`${game.players[game.activePlayerIndex].name} ne joue pas d'instant.`);
  if (getDifficultyProfile().quickDeck) {
    game.quickPasses += 1;
  }
  advanceInstant();
}

function playComputerInstantTurn() {
  const player = game.players[game.activePlayerIndex];
  if (game.phase !== "instant" || !player?.isComputer) {
    render();
    return;
  }

  const action = chooseComputerInstantAction(player);
  if (!action) {
    passInstant();
    return;
  }

  if (action.source === "field") {
    playFieldInstant(action.card.id);
    return;
  }
  playInstant(action.card.id);
}

function chooseComputerInstantAction(player) {
  if (getDifficultyProfile().randomChoices) {
    return chooseComputerRandomInstantAction(player);
  }

  if (Math.random() > getComputerInstantChance() || computerMakesMistake()) {
    return null;
  }

  const playableActions = [
    ...player.hand
      .filter((card) => isPlayableInstantCard(player, card))
      .map((card) => ({ source: "hand", card })),
    ...(player.fieldCards || [])
      .filter((card) => isPlayableFieldCard(player, card))
      .map((card) => ({ source: "field", card })),
  ];
  return playableActions[Math.floor(Math.random() * playableActions.length)] || null;
}

function chooseComputerRandomInstantAction(player) {
  if (Math.random() > getComputerInstantChance()) {
    return null;
  }

  const randomActions = [
    ...player.hand
      .filter((card) => getDifficultyProfile().quickDeck ? card.type !== "counter" || findLastUncancelledInstant() : card.type === "instant")
      .map((card) => ({ source: "hand", card })),
    ...(player.fieldCards || [])
      .filter((card) => card.type === "normal")
      .map((card) => ({ source: "field", card })),
  ];
  const action = randomActions[Math.floor(Math.random() * randomActions.length)] || null;
  if (!action) {
    return null;
  }

  const isActuallyPlayable = action.source === "field"
    ? isPlayableFieldCard(player, action.card)
    : isPlayableInstantCard(player, action.card);
  return isActuallyPlayable && !computerMakesMistake() ? action : null;
}

function playQuickCounter(cardId) {
  if (!getDifficultyProfile().quickDeck) {
    return;
  }

  const player = game.players[game.activePlayerIndex];
  const cardIndex = player.hand.findIndex((card) => card.id === cardId);
  const counter = player.hand[cardIndex];
  const cancelled = findLastUncancelledInstant();

  if (game.phase !== "instant" || !counter || counter.type !== "counter" || !cancelled) {
    render();
    return;
  }

  player.hand.splice(cardIndex, 1);
  game.discard.push(counter);
  cancelled.cancelled = true;
  cancelled.counterEffect = {
    player,
    card: counter,
    target: chooseCounterDestructionTarget(player, cancelled),
  };
  game.quickPasses = 0;
  playSound("instant", { restart: true });
  addLog(`${player.name} joue Tournevis et annule l'action ${cancelled.card.name} de ${cancelled.player.name}.`);
  if (player.isComputer) {
    showInstantReveal(counter, `${player.name} joue Tournevis`);
  }
  advanceInstant();
}

function playCounter(cardId) {
  const player = game.players[game.activePlayerIndex];
  const cardIndex = player.hand.findIndex((card) => card.id === cardId);
  const counter = player.hand[cardIndex];
  const cancelled = findLastUncancelledInstant();

  if (game.phase !== "counter" || !counter || counter.type !== "counter" || player.instantPlayed) {
    return;
  }

  if (!cancelled) {
    addLog("Aucun instant à contrer.");
    advanceCounter();
    return;
  }

  player.hand.splice(cardIndex, 1);
  game.discard.push(counter);
  cancelled.cancelled = true;
  cancelled.counterEffect = {
    player,
    card: counter,
    target: chooseCounterDestructionTarget(player, cancelled),
  };
  player.instantPlayed = true;
  playSound("instant", { restart: true });
  addLog(`${player.name} joue Tournevis et annule l'action ${cancelled.card.name} de ${cancelled.player.name}.`);
  if (player.isComputer) {
    showInstantReveal(counter, `${player.name} joue Tournevis`);
  }
  advanceCounter();
}

function chooseCounterDestructionTarget(counterPlayer, cancelledAction) {
  const color = getCounterDestructionColor(cancelledAction);
  if (!color) {
    return null;
  }

  const candidates = game.players
    .map((player) => ({ owner: player, card: player.chosenCard }))
    .filter((target) =>
      target.owner !== counterPlayer &&
      target.card &&
      !target.card.destroyed &&
      !target.card.captured &&
      target.card.color === color
    );

  return candidates.find((target) => target.owner === cancelledAction.player) || candidates[0] || null;
}

function getCounterDestructionColor(cancelledAction) {
  return cancelledAction?.card?.color === "multi" ? cancelledAction?.target?.card?.color : cancelledAction?.card?.color;
}

function chooseComputerInstantCard(player) {
  const playableInstants = player.hand.filter((card) => isPlayableInstantCard(player, card));
  return playableInstants[Math.floor(Math.random() * playableInstants.length)] || null;
}

function advanceInstant() {
  game.instantCursor += 1;

  if (game.instantCursor >= game.instantOrder.length) {
    if (getDifficultyProfile().quickDeck && game.quickPasses < game.players.length) {
      game.instantCursor = 0;
      game.activePlayerIndex = game.instantOrder[0];
      if (game.players[game.activePlayerIndex].isComputer) {
        render();
        window.setTimeout(playComputerInstantTurn, COMPUTER_REACTION_DELAY_MS);
        return;
      }
      render();
      return;
    }

    if (getDifficultyProfile().quickDeck) {
      resolveInstantActions();
      resolveAttacks();
      return;
    }

    if (startCounterPhaseOrResolve()) {
      return;
    }
    resolveAttacks();
    return;
  }

  game.activePlayerIndex = game.instantOrder[game.instantCursor];
  if (game.players[game.activePlayerIndex].isComputer) {
    render();
    window.setTimeout(playComputerInstantTurn, COMPUTER_REACTION_DELAY_MS);
    return;
  }
  render();
}

function startCounterPhaseOrResolve() {
  if (!findLastUncancelledInstant() || !game.players.some((player) => player.hand.some((card) => card.type === "counter"))) {
    resolveInstantActions();
    return false;
  }

  game.phase = "counter";
  game.players.forEach((player) => {
    player.instantPlayed = false;
  });
  game.instantOrder = getClockwiseOrder(game.lastRoundWinnerIndex);
  game.instantCursor = 0;
  game.activePlayerIndex = game.instantOrder[0];
  addLog("Phase contre-instant: Tournevis peut annuler la dernière action instantanée.");

  if (game.players[game.activePlayerIndex].isComputer) {
    render();
    window.setTimeout(playComputerCounterTurn, COMPUTER_REACTION_DELAY_MS);
    return true;
  }
  render();
  return true;
}

function passCounter() {
  if (game.phase !== "counter") {
    return;
  }
  addLog(`${game.players[game.activePlayerIndex].name} ne contre pas.`);
  advanceCounter();
}

function playComputerCounterTurn() {
  const player = game.players[game.activePlayerIndex];
  if (game.phase !== "counter" || !player?.isComputer) {
    render();
    return;
  }

  const counter = chooseComputerCounterCard(player);
  if (!counter) {
    passCounter();
    return;
  }

  playCounter(counter.id);
}

function chooseComputerCounterCard(player) {
  const counter = player.hand.find((card) => card.type === "counter");
  const lastInstant = findLastUncancelledInstant();
  if (getDifficultyProfile().randomChoices) {
    if (!counter || !lastInstant || Math.random() > getComputerCounterChance() || computerMakesMistake()) {
      return null;
    }
    return counter;
  }

  if (!counter || !lastInstant || lastInstant.target.owner !== player) {
    return null;
  }
  return Math.random() < getComputerCounterChance() && !computerMakesMistake() ? counter : null;
}

function getDifficultyProfile() {
  return DIFFICULTY_PROFILES[game.difficulty] || DIFFICULTY_PROFILES.facile;
}

function getComputerInstantChance() {
  return clampChance(getDifficultyProfile().computerEfficiency);
}

function getComputerCounterChance() {
  return clampChance(getDifficultyProfile().computerEfficiency);
}

function computerMakesMistake() {
  const profile = getDifficultyProfile();
  return Math.random() < clampChance(profile.baseMistakeChance);
}

function clampChance(value) {
  return Math.max(0, Math.min(0.95, value));
}

function advanceCounter() {
  game.instantCursor += 1;

  if (game.instantCursor >= game.instantOrder.length || !findLastUncancelledInstant()) {
    resolveInstantActions();
    resolveAttacks();
    return;
  }

  game.activePlayerIndex = game.instantOrder[game.instantCursor];
  if (game.players[game.activePlayerIndex].isComputer) {
    render();
    window.setTimeout(playComputerCounterTurn, COMPUTER_REACTION_DELAY_MS);
    return;
  }
  render();
}

function resolveInstantActions() {
  game.instantActions.forEach((action) => {
    game.discard.push(action.card);

    if (action.cancelled) {
      addLog(`${action.card.name} est annulé et va à la défausse commune.`);
      resolveCounterEffect(action);
      return;
    }

    const targetCard = action.target.card;
    if (!targetCard || targetCard.destroyed || targetCard.captured) {
      addLog(`${action.card.name} n'a plus de cible valide.`);
      return;
    }

    targetCard.destroyed = true;
    targetCard.captured = true;
    action.player.scorePile.push(targetCard);
    game.lastRoundWinnerIndex = game.players.indexOf(action.player);
    addLog(`${action.card.name} détruit ${targetCard.name}; ${action.player.name} gagne 1 point.`);
  });

  game.instantActions = [];
}

function resolveCounterEffect(cancelledAction) {
  const effect = cancelledAction.counterEffect;
  const color = getCounterDestructionColor(cancelledAction);
  if (!effect) {
    return;
  }

  const targetCard = effect.target?.card;
  if (!targetCard || targetCard.destroyed || targetCard.captured || targetCard.color !== color) {
    addLog(`Tournevis ne trouve aucune cible ${color || "valide"} à détruire.`);
    return;
  }

  targetCard.destroyed = true;
  targetCard.captured = true;
  effect.player.scorePile.push(targetCard);
  game.lastRoundWinnerIndex = game.players.indexOf(effect.player);
  addLog(`Tournevis détruit ${targetCard.name}; ${effect.player.name} gagne 1 point.`);
}

function resolveAttacks() {
  const attackOrder = getClockwiseOrder(game.lastRoundWinnerIndex);
  const cardsThatBeatSomeone = new Set();

  attackOrder.forEach((index) => {
    const player = game.players[index];
    const attacker = player.chosenCard;
    const defenderOwner = game.players[getLeftIndex(index)];
    const defender = defenderOwner.chosenCard;

    if (
      !attacker ||
      !defender ||
      attacker.destroyed ||
      attacker.captured ||
      defender.destroyed ||
      defender.captured
    ) {
      return;
    }

    if (doesAttackBeat(player, attacker, defenderOwner, defender)) {
      cardsThatBeatSomeone.add(attacker);
      defender.captured = true;
      player.scorePile.push(defender);
      game.lastRoundWinnerIndex = index;
      addLog(`${player.name} capture ${defender.name} de ${defenderOwner.name}.`);
    }
  });

  game.players.forEach((player) => {
    const card = player.chosenCard;
    if (card && !card.captured && !card.destroyed) {
      const fieldLimit = getDifficultyProfile().fieldLimit;
      if (!cardsThatBeatSomeone.has(card) && player.fieldCards.length < fieldLimit) {
        player.fieldCards.push(card);
        addLog(`${player.name} garde ${card.name} face ouverte sur sa table.`);
      } else {
        game.discard.push(card);
        if (!cardsThatBeatSomeone.has(card)) {
          addLog(`${player.name} a déjà ${fieldLimit} carte${fieldLimit > 1 ? "s" : ""} en jeu: ${card.name} va à la défausse commune.`);
        }
      }
    }
    player.chosenCard = null;
    player.skippedSelection = false;
  });

  if (!getDifficultyProfile().quickDeck) {
    game.players.forEach((player) => {
      drawToFive(player);
      ensureRevealCardInHand(player);
    });
  }

  if (isGameOver()) {
    finishGame();
    return;
  }

  if (getDifficultyProfile().quickDeck) {
    game.phase = "instant";
    game.players.forEach((player) => {
      player.instantPlayed = false;
    });
    game.instantOrder = getClockwiseOrder(game.lastRoundWinnerIndex);
    game.instantCursor = 0;
    game.quickPasses = 0;
    game.activePlayerIndex = game.instantOrder[0];
    addLog("Partie éclair: les cartes restantes peuvent encore être jouées.");
    render();
    if (game.players[game.activePlayerIndex].isComputer) {
      window.setTimeout(playComputerInstantTurn, COMPUTER_REACTION_DELAY_MS);
    }
    return;
  }

  game.phase = "select";
  game.activePlayerIndex = getHumanPlayerIndex();
  prepareActivePlayerForSelection();
  addLog("Fin de ronde. Le joueur actif pige à 5 cartes.");
  render();
}

function beats(attacker, defender) {
  return normalRules[attacker.name]?.includes(defender.name) || false;
}

function doesAttackBeat(attackerOwner, attacker, defenderOwner, defender) {
  return beats(attacker, defender);
}

function finishGame() {
  game.phase = "gameover";
  if (game.startedAt) {
    game.elapsedMs = Date.now() - game.startedAt;
  }
  const bestScore = Math.max(...game.players.map((player) => player.scorePile.length));
  const winners = game.players.filter((player) => player.scorePile.length === bestScore);
  const human = game.players[getHumanPlayerIndex()];
  stopSound("playtime");
  playSound(winners.includes(human) ? "victory" : "defeat", { restart: true });
  addLog(
    winners.length === 1
      ? `${winners[0].name} gagne la partie avec ${bestScore} points.`
      : `Égalité parfaite entre ${winners.map((player) => player.name).join(", ")}.`
  );
  render();
  showGameOverDialog(winners, bestScore);
}

function showGameOverDialog(winners, bestScore) {
  if (!elements.gameOverDialog) {
    return;
  }

  const rankedPlayers = getFinalRanking();
  const rankedWinners = rankedPlayers.filter((player) => winners.includes(player));
  const winnerNames = rankedWinners.map((player) => player.name).join(", ");
  elements.gameOverTitle.textContent = winners.length === 1 ? `${rankedPlayers[0].name} gagne!` : "Égalité!";
  elements.gameOverSummary.textContent =
    winners.length === 1
      ? `${rankedPlayers[0].name} remporte le duel avec ${bestScore} point${bestScore > 1 ? "s" : ""}.`
      : `${winnerNames} terminent à égalité avec ${bestScore} point${bestScore > 1 ? "s" : ""}.`;
  elements.gameOverScores.innerHTML = rankedPlayers
    .map((player, index) => {
      const score = player.scorePile.length;
      const isWinner = winners.includes(player);
      return `
        <article class="game-over-score ${isWinner ? "winner" : ""}">
          <span>${getRankLabel(index)}</span>
          <strong>${escapeHtml(player.name)}</strong>
          <em>${score} pt${score > 1 ? "s" : ""}</em>
        </article>
      `;
    })
    .join("");

  if (!elements.gameOverDialog.open) {
    elements.gameOverDialog.showModal();
  }
}

function getFinalRanking() {
  return [...game.players].sort((left, right) => {
    const scoreDelta = right.scorePile.length - left.scorePile.length;
    if (scoreDelta !== 0) {
      return scoreDelta;
    }
    const winnerDelta =
      Number(right.scorePile.length === game.players[game.lastRoundWinnerIndex]?.scorePile.length) -
      Number(left.scorePile.length === game.players[game.lastRoundWinnerIndex]?.scorePile.length);
    return winnerDelta || game.players.indexOf(left) - game.players.indexOf(right);
  });
}

function getRankLabel(index) {
  return index === 0 ? "1er" : `${index + 1}e`;
}

function closeGameOverDialog() {
  if (elements.gameOverDialog?.open) {
    elements.gameOverDialog.close();
  }
}

function isGameOver() {
  if (getDifficultyProfile().quickDeck) {
    if (game.quickPasses >= game.players.length) {
      addLog("Tout le monde a passé: fin de la partie éclair.");
      return true;
    }

    const playableActions = game.players.some((player) => hasPlayableInstant(player));
    if (!playableActions) {
      addLog("Tout le monde a passé: fin de la partie éclair.");
    }
    return !playableActions;
  }

  if (getDrawableCardCount() === 0) {
    addLog("Il n'y a plus de cartes à piger: fin de partie.");
    return true;
  }

  return false;
}

function getDrawableCardCount() {
  return game.deck.length + game.discard.length;
}

function canStartAnotherRevealRound() {
  const selectableCardsInCirculation = [
    ...game.deck,
    ...game.discard,
    ...game.players.flatMap((player) => player.hand),
  ];
  return selectableCardsInCirculation.some((card) => card.type === "normal");
}

function render() {
  document.body.classList.toggle("is-setup", game.phase === "setup");
  document.body.classList.toggle("players-2", game.playerCount === 2);
  document.body.classList.toggle("players-3", game.playerCount === 3);
  document.body.classList.toggle("players-4", game.playerCount === 4);
  elements.setupPanel.classList.toggle("hidden", game.phase !== "setup");
  elements.deckCount.textContent = game.deck.length;
  elements.discardCount.textContent = game.discard.length;
  elements.roundCount.textContent = game.round;
  elements.phaseLabel.textContent = getPhaseLabel();
  updateDebugTimer();
  const showNextButton = game.phase === "instant";
  const showCounterButton = game.phase === "counter";
  elements.skipInstantButton.textContent = showCounterButton ? "Passer" : "Suivant";
  elements.skipInstantButton.classList.toggle("hidden", !(showNextButton || showCounterButton));
  elements.handZone.classList.toggle("has-next", showNextButton || showCounterButton);
  renderPhaseTrack();
  renderWonZone();
  renderActionButton();
  renderBattleSlots();
  renderHand();
  renderScoreboard();
  renderTurnText();
}

function updateDebugTimer() {
  if (!elements.gameTimer) {
    return;
  }
  elements.gameTimer.textContent = formatGameTimer(getCurrentGameElapsedMs());
}

function syncMatchTimer(remoteGame = {}) {
  const now = Date.now();
  const remoteElapsed = Number.isFinite(remoteGame.elapsedMs) ? Math.max(0, remoteGame.elapsedMs) : null;
  const remoteStartedAt = Number.isFinite(remoteGame.startedAt) && remoteGame.startedAt > 0 ? remoteGame.startedAt : 0;

  if (remoteStartedAt) {
    game.startedAt = remoteStartedAt;
    game.elapsedMs = remoteElapsed ?? Math.max(0, now - remoteStartedAt);
  } else {
    const currentElapsed = getCurrentGameElapsedMs();
    if (!game.startedAt) {
      game.startedAt = now - currentElapsed;
    }
    game.elapsedMs = Math.max(currentElapsed, remoteElapsed ?? 0);
  }

  if (remoteGame.phase === "gameover") {
    game.elapsedMs = remoteElapsed ?? getCurrentGameElapsedMs();
  }
  game.remoteSyncedAt = now;
}

function getCurrentGameElapsedMs() {
  if (game.phase === "setup") {
    return 0;
  }
  if (multiplayer.game) {
    const syncedElapsed = Math.max(0, game.elapsedMs || 0);
    if (game.phase === "gameover") {
      return syncedElapsed;
    }
    return syncedElapsed + Math.max(0, Date.now() - (game.remoteSyncedAt || Date.now()));
  }
  if (!game.startedAt) {
    return Math.max(0, game.elapsedMs || 0);
  }
  if (game.phase === "gameover") {
    return Math.max(0, game.elapsedMs || 0);
  }
  game.elapsedMs = Date.now() - game.startedAt;
  return game.elapsedMs;
}

function formatGameTimer(milliseconds) {
  const totalSeconds = Math.max(0, Math.floor(milliseconds / 1000));
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
}

function handlePrimaryAction() {
  if (multiplayer.game && game.phase !== "setup" && game.phase !== "gameover") {
    if (game.phase === "confirmReveal") {
      sendMultiplayerAction("confirmReveal").catch((error) => updateMultiplayerStatus(error.message || "Action multi refusée"));
      return;
    }
    if (game.phase === "reveal") {
      sendMultiplayerAction("resolve").catch((error) => updateMultiplayerStatus(error.message || "Action multi refusée"));
      return;
    }
    if (game.phase === "instant") {
      const player = game.players[game.activePlayerIndex];
      if (player?.isHuman) {
        const firstInstant = player.hand.find((card) => card.type === "instant");
        sendMultiplayerAction(firstInstant ? "instant" : "pass", firstInstant?.id || "").catch((error) => updateMultiplayerStatus(error.message || "Action multi refusée"));
      }
      return;
    }
    const player = game.players[game.activePlayerIndex];
    if (player?.isHuman) {
      const firstPlayable = player.hand.find((card) => card.type === "normal");
      if (firstPlayable) {
        sendMultiplayerAction("select", firstPlayable.id).catch((error) => updateMultiplayerStatus(error.message || "Action multi refusée"));
      } else {
        sendMultiplayerAction("pass").catch((error) => updateMultiplayerStatus(error.message || "Action multi refusée"));
      }
    }
    return;
  }

  if (game.phase === "setup") {
    startGame();
    return;
  }

  if (game.phase === "select") {
    const player = game.players[game.activePlayerIndex];
    if (!player?.isHuman) {
      return;
    }
    playFirstNormalCard(player);
    return;
  }

  if (game.phase === "instant") {
    const player = game.players[game.activePlayerIndex];
    if (player?.isHuman) {
      passInstant();
    }
    return;
  }

  if (game.phase === "counter") {
    const player = game.players[game.activePlayerIndex];
    if (player?.isHuman) {
      passCounter();
    }
    return;
  }

  if (game.phase === "gameover") {
    resetToSetup();
  }
}

function playFirstNormalCard(player) {
  const card = player.hand.find((handCard) => handCard.type === "normal");
  if (!card) {
    discardAndSkipSelection(player);
    return;
  }
  selectCard(card.id);
}

function discardAndSkipSelection(player, forcedCardIndex = 0) {
  if (!player) {
    return;
  }

  const safeIndex = Math.max(0, Math.min(forcedCardIndex, player.hand.length - 1));
  const discarded = player.hand.splice(safeIndex, 1)[0];
  player.skippedSelection = true;

  if (discarded) {
    game.discard.push(discarded);
    addLog(`${player.name} n'a aucune carte commune: ${discarded.name} est défaussée et son tour passe.`);
  } else {
    addLog(`${player.name} n'a aucune carte à jouer et passe son tour.`);
  }

  advanceSelection();
}

function renderActionButton() {
  const player = game.players[game.activePlayerIndex];
  const state = {
    label: "Lancer la partie",
    hint: "Espace",
    disabled: false,
  };

  if (game.phase === "select") {
    state.label = player?.isHuman ? "Jouer une carte" : "Ordinateur";
    state.hint = player?.isHuman ? "Espace" : "Patiente";
    state.disabled = !player?.isHuman;
  } else if (game.phase === "confirmReveal") {
    state.label = player?.isHuman ? "Confirmer reveal" : "Attente";
    state.hint = player?.isHuman ? "Espace" : "Patiente";
    state.disabled = !player?.isHuman || Boolean(player?.revealConfirmed);
  } else if (game.phase === "reveal") {
    state.label = "Continuer";
    state.hint = "Espace";
    state.disabled = false;
  } else if (game.phase === "instant") {
    state.label = player?.isHuman ? "Suivant" : "Ordinateur";
    state.hint = player?.isHuman ? "Espace" : "Patiente";
    state.disabled = !player?.isHuman;
  } else if (game.phase === "counter") {
    state.label = player?.isHuman ? "Passer" : "Ordinateur";
    state.hint = player?.isHuman ? "Tournevis ou espace" : "Patiente";
    state.disabled = !player?.isHuman;
  } else if (game.phase === "gameover") {
    state.label = "Nouvelle partie";
    state.hint = "Espace";
  }

  elements.actionButtonLabel.textContent = state.label;
  elements.actionButtonHint.textContent = state.hint;
  elements.actionButton.disabled = state.disabled;
}

function renderTurnText() {
  if (game.phase === "setup") {
    elements.turnTitle.textContent = "Prêt à jouer";
    elements.phaseHint.textContent = "Mélange le paquet central pour commencer.";
    elements.activePlayerTitle.textContent = "Aucun joueur";
    return;
  }

  if (game.phase === "select") {
    const player = game.players[game.activePlayerIndex];
    elements.turnTitle.textContent = "Selection";
    elements.phaseHint.textContent = multiplayer.game ? "Beta multi: pose une carte jouable." : "Pose une carte normale face cachee.";
    elements.activePlayerTitle.textContent = player.name;
    return;
  }

  if (game.phase === "confirmReveal") {
    const player = game.players[game.activePlayerIndex];
    elements.turnTitle.textContent = "Confirmation";
    elements.phaseHint.textContent = "Les deux joueurs doivent confirmer avant de révéler.";
    elements.activePlayerTitle.textContent = player?.name || "Table";
    return;
  }

  if (game.phase === "reveal") {
    elements.turnTitle.textContent = "Reveal";
    elements.phaseHint.textContent = "Les cartes sont révélées. Résous la ronde pour continuer.";
    elements.activePlayerTitle.textContent = "Table";
    return;
  }

  if (game.phase === "instant") {
    const player = game.players[game.activePlayerIndex];
    elements.turnTitle.textContent = "Instant";
    elements.phaseHint.textContent = hasPlayableInstant(player)
      ? "Joue une action instantanée ou appuie sur Suivant."
      : "Aucune action instantanée jouable: appuie sur Suivant.";
    elements.activePlayerTitle.textContent = player.name;
    return;
  }

  if (game.phase === "counter") {
    const player = game.players[game.activePlayerIndex];
    elements.turnTitle.textContent = "Contre-instant";
    elements.phaseHint.textContent = "Joue Tournevis pour annuler la dernière action instantanée, ou passe.";
    elements.activePlayerTitle.textContent = player.name;
    return;
  }

  const scores = game.players.map((player) => player.scorePile.length);
  const bestScore = Math.max(...scores);
  const winners = game.players.filter((player) => player.scorePile.length === bestScore);
  elements.turnTitle.textContent = winners.length === 1 ? `${winners[0].name} gagne` : "Égalité";
  elements.phaseHint.textContent = "La partie est terminée.";
  elements.activePlayerTitle.textContent = "Partie terminée";
}

function renderBattleSlots() {
  elements.battleSlots.innerHTML = "";
  game.players.forEach((player, index) => {
    const card = player.chosenCard;
    const fieldCards = player.fieldCards || [];
    const playerName = escapeHtml(player.name);
    const slot = document.createElement("article");
    slot.className = `battle-slot player-${index + 1}`;
    slot.classList.toggle("destroyed", Boolean(card?.destroyed));
    slot.classList.toggle("active", game.activePlayerIndex === index && game.phase !== "setup");
    slot.classList.toggle("skipped", Boolean(player.skippedSelection && !card));
    const hiddenCard = card && (game.phase === "select" || game.phase === "confirmReveal");
    const slotCells = [0, 1, 2]
      .map((cellIndex) => {
        const fieldIndex = card ? (cellIndex < 1 ? cellIndex : cellIndex - 1) : cellIndex;
        const fieldCard = fieldCards[fieldIndex];
        const showBattleCard = cellIndex === 1 && card;

        if (showBattleCard) {
          const image = hiddenCard ? CARD_BACK : card.image;
          const label = hiddenCard ? "Carte face cachee" : card.name;
          return `<div class="field-cell played-card battle-card"><img src="${image}" alt="${label}" /></div>`;
        }

        if (cellIndex === 1 && player.skippedSelection && !card) {
          return `<div class="field-cell skipped-card"><strong>Passe</strong></div>`;
        }

        if (fieldCard) {
          const playable = game.phase === "instant" && game.activePlayerIndex === index && player.isHuman && isPlayableFieldCard(player, fieldCard);
          const tag = playable ? "button" : "div";
          const attrs = playable ? ` type="button" data-field-card-id="${escapeHtml(fieldCard.id)}" aria-label="Jouer ${escapeHtml(fieldCard.name)}"` : "";
          return `<${tag} class="field-cell played-card stored-card ${playable ? "playable-field-card" : ""}"${attrs}><img src="${fieldCard.image}" alt="${fieldCard.name}" /></${tag}>`;
        }

        return `<div class="field-cell empty-cell"><span></span></div>`;
      })
      .join("");
    slot.innerHTML = `
      <div class="slot-board">
        <div class="slot-header">
          <strong>${playerName}</strong>
        </div>
        <div class="field-row">${slotCells}</div>
      </div>
    `;
    elements.battleSlots.append(slot);
    slot.querySelectorAll("[data-field-card-id]").forEach((button) => {
      button.addEventListener("click", () => selectCard(button.dataset.fieldCardId));
    });
  });
}

function renderHand() {
  elements.handCards.innerHTML = "";

  if (game.phase === "setup" || game.phase === "gameover") {
    elements.handCards.innerHTML = `<p class="hint">Aucune main active.</p>`;
    return;
  }

  const player = game.players[game.activePlayerIndex];
  if (!player.isHuman) {
    const hiddenCount = Math.max(0, player.hand.length);
    for (let index = 0; index < hiddenCount; index += 1) {
      const cardBack = document.createElement("div");
      cardBack.className = "hand-card hidden-hand-card";
      cardBack.innerHTML = `
        <img src="${CARD_BACK}" alt="Carte cachee" />
        <strong>Carte cachee</strong>
        <small>${player.name}</small>
      `;
      elements.handCards.append(cardBack);
    }

    if (!hiddenCount) {
      elements.handCards.innerHTML = `<p class="hint">${player.name} n'a plus de cartes en main.</p>`;
    }
    return;
  }

  player.hand.forEach((card) => {
    const button = document.createElement("button");
    const disabled =
      (game.phase === "select" && card.type !== "normal") ||
      (game.phase === "confirmReveal" || game.phase === "reveal") ||
      (game.phase === "instant" && !isPlayableInstantCard(player, card)) ||
      (game.phase === "counter" && (player.instantPlayed || card.type !== "counter"));
    button.className = `hand-card ${card.type} color-${card.color}`;
    button.type = "button";
    button.disabled = disabled;
    button.innerHTML = `
      <img src="${card.image}" alt="${card.name}" />
      <strong>${card.name}</strong>
      <small>${cardLabel(card)}</small>
    `;
    button.addEventListener("click", () => selectCard(card.id));
    elements.handCards.append(button);
  });
}

function renderScoreboard() {
  elements.scoreboard.innerHTML = "";
  game.players.forEach((player) => {
    const index = game.players.indexOf(player);
    const item = document.createElement("article");
    item.className = `score-card player-${index + 1}`;
    item.innerHTML = `
      <div class="score-line">
        <strong>${escapeHtml(player.name)}</strong>
        <span>${player.scorePile.length} pt${player.scorePile.length > 1 ? "s" : ""}</span>
      </div>
      <small>${player.hand.length} cartes en main | ${(player.fieldCards || []).length} en jeu</small>
    `;
    elements.scoreboard.append(item);
  });
}

function cardLabel(card) {
  if (card.type === "normal") {
    return `Duel - ${card.color}`;
  }
  if (card.type === "counter") {
    return "Rare - contre-instant";
  }
  return `Instant - ${card.color}`;
}

function getCardCost(card) {
  const costs = {
    normal: 1,
    instant: 2,
    counter: 4,
  };
  return costs[card.type] || 1;
}

function renderWonZone() {
  const human = game.players[getHumanPlayerIndex()];
  elements.wonCount.textContent = human?.scorePile.length || 0;
  elements.wonOwnerLabel.textContent = human?.name || "Joueur 1";
  elements.wonStack.innerHTML = "";

  if (!human?.scorePile.length) {
    return;
  }

  human.scorePile.slice(-5).forEach((card) => {
    const button = document.createElement("button");
    button.className = "won-card-thumb";
    button.type = "button";
    button.setAttribute("aria-label", `Voir ${card.name}`);
    button.innerHTML = `<img src="${card.image}" alt="${card.name}" />`;
    button.addEventListener("click", () => showCardZoom(card.image, card.name));
    elements.wonStack.append(button);
  });
}

function showDrawReveal(card, player) {
  lastDrawnCard = card;
  clearTimeout(drawRevealTimer);
  playSound("draw", { restart: true });
  elements.drawRevealImage.src = card.image;
  elements.drawRevealImage.alt = card.name;
  elements.drawRevealLabel.textContent = `${player.name} pige ${card.name}`;
  elements.drawReveal.classList.remove("show");
  void elements.drawReveal.offsetWidth;
  elements.drawReveal.classList.add("show");
  drawRevealTimer = setTimeout(() => {
    elements.drawReveal.classList.remove("show");
  }, 1700);
}

function showInstantReveal(card, label) {
  clearTimeout(instantRevealTimer);
  elements.instantRevealImage.src = card.image;
  elements.instantRevealImage.alt = card.name;
  elements.instantRevealLabel.textContent = label;
  elements.instantReveal.classList.remove("show");
  void elements.instantReveal.offsetWidth;
  elements.instantReveal.classList.add("show");
  instantRevealTimer = setTimeout(() => {
    elements.instantReveal.classList.remove("show");
  }, 1500);
}

function showCenterDeckZoom() {
  if (lastDrawnCard) {
    showCardZoom(lastDrawnCard.image, `Derniere pige: ${lastDrawnCard.name}`);
    return;
  }
  showCardZoom(CARD_BACK, "Paquet central");
}

function quitApplication() {
  if (multiplayerSocket?.connected && multiplayer.roomCode) {
    multiplayerSocket.emit("leaveRoom");
  }
  stopAllSounds();
  if (window.KibakiApp?.quit) {
    window.KibakiApp.quit();
    return;
  }

  window.open("", "_self");
  window.close();
  addLog("Pour quitter, ferme simplement cette fenêtre KIBAKI.");
}

function showCardZoom(image, label) {
  elements.cardZoomImage.src = image;
  elements.cardZoomImage.alt = label;
  elements.cardZoomLabel.textContent = label;
  elements.cardZoomDialog.showModal();
}

function renderPhaseTrack() {
  const phases = ["setup", "select", "confirmReveal", "reveal", "instant", "counter", "gameover"];
  const activeIndex = Math.max(0, phases.indexOf(game.phase));
  elements.phaseDots.innerHTML = phases
    .map((phase, index) => {
      const className = index <= activeIndex ? "dot active" : "dot";
      return `<span class="${className}" title="${getPhaseLabelFor(phase)}"></span>`;
    })
    .join("");
}

function getPhaseLabelFor(phase) {
  const labels = {
    setup: "Setup",
    select: "Choix",
    confirmReveal: "Confirmer",
    reveal: "Reveal",
    instant: "Instants",
    counter: "Contre",
    gameover: "Fin",
  };
  return labels[phase] || phase;
}

function playerInitials(name) {
  return escapeHtml(
    String(name)
      .trim()
      .split(/\s+/)
      .map((part) => part[0])
      .join("")
      .slice(0, 2)
      .toUpperCase() || "P"
  );
}

function escapeHtml(value) {
  return String(value).replace(/[&<>"']/g, (character) => (
    {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    }[character]
  ));
}

function getPhaseLabel() {
  return getPhaseLabelFor(game.phase);
}

function getClockwiseOrder(startIndex) {
  return game.players.map((_, offset) => (startIndex + offset) % game.players.length);
}

function getLeftIndex(index) {
  return (index + 1) % game.players.length;
}

function getHumanPlayerIndex() {
  const humanIndex = game.players.findIndex((player) => player.isHuman);
  return humanIndex >= 0 ? humanIndex : 0;
}

function addLog(message) {
  const item = document.createElement("li");
  item.textContent = message;
  elements.battleLog.prepend(item);
}

function shuffle(cards) {
  const shuffled = [...cards];
  for (let index = shuffled.length - 1; index > 0; index -= 1) {
    const swapIndex = Math.floor(Math.random() * (index + 1));
    [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
  }
  return shuffled;
}

